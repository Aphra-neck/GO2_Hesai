capture_ros_graph() {
  local session_dir="$1"
  declare -n stop_requested_ref="$2"
  command -v ros2 >/dev/null 2>&1 || return 0
  (( $(session_bytes "${session_dir}") < SESSION_STOP_BYTES )) || return 0
  (( stop_requested_ref == 0 )) || return 0

  timeout 8 ros2 topic list --no-daemon --spin-time 3 -t \
    > "${session_dir}/topics.txt.tmp" 2>&1 || true
  if (( stop_requested_ref != 0 )); then
    rm -f -- "${session_dir}/topics.txt.tmp"
    return 0
  fi
  cap_text_file "${session_dir}/topics.txt.tmp"
  mv -f -- "${session_dir}/topics.txt.tmp" "${session_dir}/topics.txt"

  local nodes
  nodes="$(timeout 8 ros2 node list --no-daemon --spin-time 3 2>/dev/null || true)"
  (( stop_requested_ref == 0 )) || return 0
  printf '%s\n' "${nodes}" > "${session_dir}/nodes.txt"
  cap_text_file "${session_dir}/nodes.txt"

  local node safe_name output_file param_status
  while IFS= read -r node; do
    (( stop_requested_ref == 0 )) || break
    [[ "${node}" =~ (super_lio|body_odom_adapter|terrain_mapper|body_lattice_planner|go2_sdk2_bridge|go2_sdk2_direct_bridge|go2_imu_bridge|hesai_ros_driver) ]] || continue
    safe_name="$(printf '%s' "${node#/}" | tr -c 'A-Za-z0-9_.-' '_')"
    output_file="${session_dir}/parameters_${safe_name}.yaml"
    [[ -f "${output_file}" ]] && continue
    # Humble param dump creates two DirectNodes before querying services.
    param_status=0
    timeout 15 ros2 param dump --no-daemon --spin-time 3 "${node}" \
      > "${output_file}.tmp" 2>&1 || param_status=$?
    if (( stop_requested_ref != 0 )); then
      rm -f -- "${output_file}.tmp"
      break
    fi
    if (( param_status == 0 )) && [[ -s "${output_file}.tmp" ]]; then
      cap_text_file "${output_file}.tmp"
      mv -f -- "${output_file}.tmp" "${output_file}"
    else
      rm -f -- "${output_file}.tmp"
      append_event "${session_dir}" warning collector \
        "parameter capture for ${node} failed or was empty (exit ${param_status}); will retry"
    fi
  done <<< "${nodes}"
}

sample_topic_rate() {
  local session_dir="$1"
