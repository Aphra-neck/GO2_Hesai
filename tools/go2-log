process_resource_sample() {
  local pid="$1"
  [[ -r "/proc/${pid}/stat" ]] || return 1
  local stat_line stat_tail page_size
  local -a fields=()
  IFS= read -r stat_line < "/proc/${pid}/stat" || return 1
  stat_tail="${stat_line##*) }"
  read -r -a fields <<< "${stat_tail}"
  (( ${#fields[@]} >= 22 )) || return 1
  page_size="$(getconf PAGESIZE 2>/dev/null || printf '4096')"
  printf '%s %s %s %s %s\n' \
    "${fields[0]}" \
    "${fields[19]}" \
    "$(( fields[11] + fields[12] ))" \
    "$(( fields[21] * page_size / 1024 ))" \
    "${fields[17]}"
}

classify_process_metrics_status() {
  local running="$1"
  local failures="$2"
  local cpu_clock_available="$3"
  local metric_samples="$4"
  local cpu_samples="$5"
  if (( running == 0 )); then
    printf 'stopped\n'
  elif (( failures > 0 || cpu_clock_available == 0 )); then
    printf 'partial\n'
  elif (( cpu_samples == 0 )); then
    printf 'baseline\n'
  elif (( cpu_samples < metric_samples )); then
    printf 'partial\n'
  else
    printf 'ok\n'
  fi
}

sample_process_health() {
  local session_dir="$1"
  local timestamp="$2"
  local spec component pattern pids running previous
  declare -n previous_states_ref="$3"
  declare -n previous_cpu_ref="$4"

  local clock_ticks uptime_ticks
  clock_ticks="$(getconf CLK_TCK 2>/dev/null || printf '100')"
  uptime_ticks="$(LC_ALL=C awk -v hz="${clock_ticks}" \
    '{printf "%.0f", $1 * hz}' /proc/uptime 2>/dev/null || true)"

  for spec in "${COMPONENT_SPECS[@]}"; do
    component="${spec%%:*}"
    pattern="${spec#*:}"
    pids="$(pgrep -f "${pattern}" 2>/dev/null | paste -sd ';' - || true)"
    if [[ -n "${pids}" ]]; then
      running=1
    else
      running=0
    fi

    local pid metrics state start_ticks process_ticks rss threads key prior
    local prior_ticks prior_uptime delta_ticks delta_uptime
    local states='' rss_total=0 thread_total=0 cpu_total='0'
    local cpu_samples=0 metric_samples=0 failures=0 cpu_clock_available=0
    [[ "${uptime_ticks}" =~ ^[0-9]+$ ]] && cpu_clock_available=1
    while IFS= read -r pid; do
      [[ -n "${pid}" ]] || continue
      if ! metrics="$(process_resource_sample "${pid}" 2>/dev/null)"; then
        failures=$((failures + 1))
        continue
      fi
      read -r state start_ticks process_ticks rss threads <<< "${metrics}"
      metric_samples=$((metric_samples + 1))
      states+="${states:+;}${pid}:${state}"
      rss_total=$((rss_total + rss))
      thread_total=$((thread_total + threads))
      key="${pid}:${start_ticks}"
      prior="${previous_cpu_ref[${key}]:-}"
      if [[ -n "${prior}" && "${uptime_ticks}" =~ ^[0-9]+$ ]]; then
        read -r prior_ticks prior_uptime <<< "${prior}"
        delta_ticks=$((process_ticks - prior_ticks))
        delta_uptime=$((uptime_ticks - prior_uptime))
        if (( delta_ticks >= 0 && delta_uptime > 0 )); then
          cpu_total="$(LC_ALL=C awk \
            -v total="${cpu_total}" -v work="${delta_ticks}" -v elapsed="${delta_uptime}" \
            'BEGIN {printf "%.3f", total + 100.0 * work / elapsed}')"
          cpu_samples=$((cpu_samples + 1))
        fi
      fi
      if [[ "${uptime_ticks}" =~ ^[0-9]+$ ]]; then
        previous_cpu_ref["${key}"]="${process_ticks} ${uptime_ticks}"
      fi
    done < <(tr ';' '\n' <<< "${pids}")

    local cpu_value='' metrics_status
    metrics_status="$(classify_process_metrics_status \
      "${running}" "${failures}" "${cpu_clock_available}" \
      "${metric_samples}" "${cpu_samples}")"
    if [[ "${metrics_status}" == stopped ]]; then
      rss_total=0
      thread_total=0
    elif (( cpu_samples > 0 )); then
      cpu_value="${cpu_total}"
    fi
    printf '%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
      "${timestamp}" "${component}" "${running}" "${pids}" "${states}" \
      "${cpu_value}" "${rss_total}" "${thread_total}" "${metrics_status}" \
      >> "${session_dir}/process_health.csv"

    previous="${previous_states_ref[${component}]:-unknown}"
    if [[ "${previous}" != "${running}" ]]; then
      if [[ "${running}" == 1 ]]; then
        append_event "${session_dir}" info lifecycle "${component} started (pids=${pids})"
      elif [[ "${previous}" != unknown ]]; then
        append_event "${session_dir}" warning lifecycle "${component} stopped"
      fi
      previous_states_ref["${component}"]="${running}"
    fi
  done
}

sample_system_health() {
  local session_dir="$1"
  local timestamp="$2"
  local monotonic_ns='' load1='' load5='' load15=''
  local mem_available='' swap_free='' thermal_max='' thermal_zone='' status=ok
  monotonic_ns="$(LC_ALL=C awk '{printf "%.0f", $1 * 1000000000}' \
    /proc/uptime 2>/dev/null || true)"
  read -r load1 load5 load15 _ < /proc/loadavg || status=partial
  mem_available="$(awk '$1 == "MemAvailable:" {print $2; exit}' /proc/meminfo 2>/dev/null || true)"
  swap_free="$(awk '$1 == "SwapFree:" {print $2; exit}' /proc/meminfo 2>/dev/null || true)"

  local path value zone
  for path in /sys/class/thermal/thermal_zone*/temp; do
    [[ -r "${path}" ]] || continue
    value="$(read_first_line "${path}" 2>/dev/null || true)"
    [[ "${value}" =~ ^-?[0-9]+$ ]] || continue
    zone="$(read_first_line "${path%/temp}/type" 2>/dev/null || basename "${path%/temp}")"
    if [[ -z "${thermal_max}" ]] || (( value > thermal_max )); then
      thermal_max="${value}"
      thermal_zone="${zone//,/__}"
    fi
  done
  [[ -n "${monotonic_ns}" && -n "${load1}" && -n "${mem_available}" ]] || status=partial
  printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
    "${timestamp}" "${monotonic_ns}" "${load1}" "${load5}" "${load15}" \
    "${mem_available}" "${swap_free}" "${thermal_max}" "${thermal_zone}" "${status}" \
    >> "${session_dir}/system_health.csv"
}

sample_network_health() {
  local session_dir="$1"
  local timestamp="$2"
  local monotonic_ns path interface operstate carrier status field value
  local -a fields=(rx_bytes rx_packets rx_errors rx_dropped tx_bytes tx_packets tx_errors tx_dropped)
  monotonic_ns="$(LC_ALL=C awk '{printf "%.0f", $1 * 1000000000}' \
    /proc/uptime 2>/dev/null || true)"
  for path in /sys/class/net/*; do
    [[ -d "${path}" ]] || continue
    interface="$(basename -- "${path}")"
    [[ "${interface}" != lo ]] || continue
    operstate="$(read_first_line "${path}/operstate" 2>/dev/null || true)"
    carrier="$(read_first_line "${path}/carrier" 2>/dev/null || true)"
    status=ok
    [[ "${monotonic_ns}" =~ ^[0-9]+$ && -n "${operstate}" && "${carrier}" =~ ^[01]$ ]] ||
      status=partial
    local -a values=()
    for field in "${fields[@]}"; do
      value="$(read_first_line "${path}/statistics/${field}" 2>/dev/null || true)"
      [[ "${value}" =~ ^[0-9]+$ ]] || status=partial
      values+=("${value}")
    done
    printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
      "${timestamp}" "${monotonic_ns}" "${interface}" "${operstate}" "${carrier}" \
      "${values[0]}" "${values[1]}" "${values[2]}" "${values[3]}" \
      "${values[4]}" "${values[5]}" "${values[6]}" "${values[7]}" "${status}" \
      >> "${session_dir}/network_health.csv"
  done
}

sample_hesai_summary() {
  local session_dir="$1"
  local timestamp="$2"
  declare -n previous_frame_ref="$3"
  local log_path="${SLAM_LOG_DIR:-${HOME}/slam_logs}/hesai.log"
  local status=missing size='' modified='' frame='' delta='' points='' packets=''
  local start_time='' end_time='' warning_lines='' error_lines='' tail_text='' last_line=''
  if [[ -f "${log_path}" && ! -L "${log_path}" ]]; then
    size="$(stat -c '%s' -- "${log_path}" 2>/dev/null || true)"
    modified="$(stat -c '%Y' -- "${log_path}" 2>/dev/null || true)"
    tail_text="$(
      LC_ALL=C tail -c "${HESAI_TAIL_BYTES}" -- "${log_path}" 2>/dev/null |
        tail -n 512 || true
    )"
    last_line="$(awk '/raw frame:/ {line=$0} END {print line}' <<< "${tail_text}")"
    warning_lines="$(grep -Eic 'warn|warning' <<< "${tail_text}" || true)"
    error_lines="$(grep -Eic 'error|fatal|exception' <<< "${tail_text}" || true)"
    if [[ "${last_line}" =~ raw[[:space:]]+frame:([0-9]+)[[:space:]]+points:([0-9]+)[[:space:]]+packet:([0-9]+)[[:space:]]+start[[:space:]]+time:([^[:space:]]+)[[:space:]]+end[[:space:]]+time:([^[:space:]]+) ]]; then
      frame="${BASH_REMATCH[1]}"
      points="${BASH_REMATCH[2]}"
      packets="${BASH_REMATCH[3]}"
      start_time="${BASH_REMATCH[4]}"
      end_time="${BASH_REMATCH[5]}"
      status=ok
      if [[ "${previous_frame_ref}" =~ ^[0-9]+$ ]]; then
        if (( frame >= previous_frame_ref )); then
          delta=$((frame - previous_frame_ref))
        else
          status=frame_reset
        fi
      fi
      previous_frame_ref="${frame}"
    else
      status=unparsed
    fi
  fi
  printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
    "${timestamp}" "${status}" "${size}" "${modified}" "${frame}" "${delta}" \
    "${points}" "${packets}" "${start_time}" "${end_time}" \
    "${warning_lines}" "${error_lines}" >> "${session_dir}/hesai_summary.csv"
}

run_topic_timing_sampler() {
  local session_dir="$1"
  local timing_file="${session_dir}/topic_timing.csv"
  local status=0
  # TERM at seven seconds and KILL one second later bounds even a stuck helper
  # to eight seconds of wall-clock time.
  if [[ -n "${GO2_TOPIC_TIMING_COMMAND:-}" ]]; then
    timeout --foreground --kill-after=1 7 "${GO2_TOPIC_TIMING_COMMAND}" \
      --timing-csv "${timing_file}" \
      --rates-csv "${session_dir}/topic_rates.csv" \
      --duration 5 --max-bytes "${TOPIC_TIMING_MAX_BYTES}" || status=$?
  else
    local helper="${REPO_ROOT}/tools/sample_topic_timing.py"
    [[ -r "${helper}" ]] || helper="${SCRIPT_DIR}/sample_topic_timing.py"
    timeout --foreground --kill-after=1 7 python3 "${helper}" \
      --timing-csv "${timing_file}" \
      --rates-csv "${session_dir}/topic_rates.csv" \
      --duration 5 --max-bytes "${TOPIC_TIMING_MAX_BYTES}" || status=$?
  fi
  return "${status}"
}

sample_topic_timing() {
  local session_dir="$1"
  declare -n timing_pid_ref="$2"
  declare -n timing_boot_id_ref="$3"
  declare -n timing_start_ticks_ref="$4"
  local timing_file="${session_dir}/topic_timing.csv"
  local marker="${session_dir}/topic_timing_capacity_reached.txt"
  local size
  size="$(stat -c '%s' -- "${timing_file}" 2>/dev/null || printf '0')"
  if (( size >= TOPIC_TIMING_MAX_BYTES )); then
    [[ -f "${marker}" ]] || printf '%s topic timing capture reached %s bytes\n' \
      "$(utc_now)" "${TOPIC_TIMING_MAX_BYTES}" > "${marker}"
    return 0
  fi

  if ! command -v setsid >/dev/null 2>&1; then
    append_event "${session_dir}" warning collector \
      "topic timing sampler skipped because setsid is unavailable"
    return 0
  fi

  local status=0 timing_identity=''
  setsid "${SCRIPT_DIR}/go2-log" _timing "${session_dir}" &
  timing_pid_ref="$!"
  if timing_identity="$(capture_timing_identity "${timing_pid_ref}" "${session_dir}")"; then
    read -r timing_boot_id_ref timing_start_ticks_ref <<< "${timing_identity}"
  elif kill -0 "${timing_pid_ref}" 2>/dev/null; then
    append_event "${session_dir}" warning collector \
      "could not capture the complete timing identity for PID ${timing_pid_ref}"
  fi
  wait "${timing_pid_ref}" 2>/dev/null || status=$?
  if ! kill -0 "${timing_pid_ref}" 2>/dev/null ||
    [[ "$(process_state "${timing_pid_ref}" 2>/dev/null || true)" == Z ]]; then
    rm -f -- "${session_dir}/timing.identity"
    timing_pid_ref=''
    timing_boot_id_ref=''
    timing_start_ticks_ref=''
  fi

  if (( status == 3 )); then
    [[ -f "${marker}" ]] || printf '%s topic timing capture reached its file ceiling\n' \
      "$(utc_now)" > "${marker}"
  elif (( status != 0 )); then
    append_event "${session_dir}" warning collector \
      "topic timing sampler failed with exit ${status}"
  fi
}

run_rosout_collector() {
  local session_dir="$1"
  command -v ros2 >/dev/null 2>&1 || exit 0

  # A 32 MiB per-file ceiling stays inside the headroom above the stop threshold.
  ulimit -f 32768 2>/dev/null || true
  ros2 topic echo --no-daemon --spin-time 3 /rosout 2>/dev/null | awk '
    BEGIN { RS="---[[:space:]]*\n"; ORS="---\n" }
    /(^|\n)level: (30|40|50)(\n|$)/ { print; fflush() }
  ' >> "${session_dir}/rosout_warn_error.txt"
}

run_collector() {
  local session_dir="$1"
  local session_id
  session_id="$(basename -- "${session_dir}")"
  source_ros_environment

  local stop_requested=0
  local rosout_pid=''
  local rosout_boot_id=''
  local rosout_start_ticks=''
  local timing_pid=''
  local timing_boot_id=''
  local timing_start_ticks=''
  # Passed by name to sample_process_health via Bash's declare -n.
  # shellcheck disable=SC2034
  declare -A previous_states=()
  # shellcheck disable=SC2034
  declare -A previous_cpu_samples=()
  local previous_hesai_frame=''

  request_stop() {
    stop_requested=1
  }

  finish_collector() {
    local writer_cleanup_failed=0
    if [[ -n "${timing_pid}" ]]; then
      local timing_stop_status=0
      if [[ -n "${timing_boot_id}" && -n "${timing_start_ticks}" ]]; then
        stop_timing_sampler_process \
          "${timing_pid}" "${timing_boot_id}" "${timing_start_ticks}" "${session_dir}" ||
          timing_stop_status=$?
      else
        timing_stop_status=2
      fi
      if (( timing_stop_status == 2 )); then
        writer_cleanup_failed=1
        append_event "${session_dir}" warning collector \
          "timing identity mismatch for PID ${timing_pid}; no signal was sent"
      elif (( timing_stop_status != 0 )); then
        writer_cleanup_failed=1
        append_event "${session_dir}" warning collector \
          "failed to stop the verified timing process PID ${timing_pid}"
      else
        rm -f -- "${session_dir}/timing.identity"
      fi
      timing_pid=''
    fi
    if [[ -n "${rosout_pid}" ]]; then
      local rosout_stop_status=0
      stop_rosout_collector_process \
        "${rosout_pid}" "${rosout_boot_id}" "${rosout_start_ticks}" "${session_dir}" ||
        rosout_stop_status=$?
      if (( rosout_stop_status == 2 )); then
        writer_cleanup_failed=1
        append_event "${session_dir}" warning collector \
          "rosout identity mismatch for PID ${rosout_pid}; no signal was sent"
      elif (( rosout_stop_status != 0 )); then
        writer_cleanup_failed=1
        append_event "${session_dir}" warning collector \
          "failed to stop the verified rosout process PID ${rosout_pid}"
      fi
      rosout_pid=''
    fi
    append_event "${session_dir}" info collector "collector stopped"
    printf '%s\n' "$(utc_now)" > "${session_dir}/ended_at.txt"
    enforce_session_size_limit "${session_dir}" ||
      echo "WARNING: preserve the oversized session with SCP: ${session_dir}" >&2
    if [[ -f "${ACTIVE_FILE}" ]] && [[ "$(< "${ACTIVE_FILE}")" == "${session_dir}" ]]; then
      local remaining_writers='' all_auxiliary_writers=''
      if ! all_auxiliary_writers="$(running_auxiliary_diagnostic_writers)"; then
        writer_cleanup_failed=1
        append_event "${session_dir}" warning collector \
          "diagnostic writer process query failed; active-session state was preserved"
      else
        remaining_writers="$(
          grep -F -- "${session_dir}" <<< "${all_auxiliary_writers}" || true
        )"
      fi
      if (( writer_cleanup_failed == 0 )) && [[ -z "${remaining_writers}" ]]; then
        rm -f -- "${ACTIVE_FILE}"
      else
        append_event "${session_dir}" warning collector \
          "active-session state preserved because a diagnostic writer is still running"
      fi
    fi
  }

  trap request_stop INT TERM
  trap finish_collector EXIT

  if command -v setsid >/dev/null 2>&1 && command -v ros2 >/dev/null 2>&1; then
    setsid "${SCRIPT_DIR}/go2-log" _rosout "${session_dir}" &
    rosout_pid="$!"
    printf '%s\n' "${rosout_pid}" > "${session_dir}/rosout.pid"
    local rosout_identity
    if rosout_identity="$(capture_rosout_identity "${rosout_pid}" "${session_dir}")"; then
      read -r rosout_boot_id rosout_start_ticks <<< "${rosout_identity}"
    else
      append_event "${session_dir}" warning collector \
        "could not capture the complete rosout identity for PID ${rosout_pid}"
    fi
  fi

  append_event "${session_dir}" info collector "collector started"
  local graph_cycle=0 size timestamp topic
  while (( stop_requested == 0 )); do
    size="$(session_bytes "${session_dir}")"
    if (( size >= SESSION_STOP_BYTES )); then
      printf '%s session collection stopped at %s to enforce the 100 MiB limit\n' \
        "$(utc_now)" "$(human_bytes "${size}")" > "${session_dir}/capacity_reached.txt"
      break
    fi

    timestamp="$(utc_now)"
    sample_process_health \
      "${session_dir}" "${timestamp}" previous_states previous_cpu_samples
    sample_system_health "${session_dir}" "${timestamp}"
    sample_network_health "${session_dir}" "${timestamp}"
    sample_hesai_summary "${session_dir}" "${timestamp}" previous_hesai_frame
    sample_topic_timing \
      "${session_dir}" timing_pid timing_boot_id timing_start_ticks
    (( stop_requested == 0 )) || break

    if (( graph_cycle % 4 == 0 )); then
      capture_ros_graph "${session_dir}" stop_requested
    fi
    (( stop_requested == 0 )) || break
    graph_cycle=$((graph_cycle + 1))

    for topic in /imu/data /lio/odom /lio/body_odom /body_path /terrain_costmap /sdk2_command; do
      (( stop_requested == 0 )) || break
      (( $(session_bytes "${session_dir}") < SESSION_STOP_BYTES )) || break
      sample_topic_rate "${session_dir}" "${topic}"
    done
    (( stop_requested == 0 )) || break
    sample_odometry_pair "${session_dir}"
    (( stop_requested == 0 )) || break
    sample_sdk2_command "${session_dir}"

    local slept=0
    while (( slept < 10 && stop_requested == 0 )); do
      sleep 1
      slept=$((slept + 1))
    done
  done

  # On a normal return, run cleanup while this function's local state is still
  # in scope. The EXIT trap remains the fallback for errors and abrupt exits.
  finish_collector
  trap - EXIT INT TERM
}

write_start_result() {
  local result_file="$1"
  local ownership="$2"
  local session_dir="$3"
  [[ -n "${result_file}" ]] || return 0

  local session_id result_temp
  session_id="$(basename -- "${session_dir}")"
  [[ "${ownership}" == created || "${ownership}" == existing ]] ||
    die "invalid diagnostic start ownership result: ${ownership}"
  [[ -n "${session_id}" && "${session_id}" != *$'\n'* &&
      "${session_dir}" != *$'\n'* ]] ||
    die "diagnostic start result contains an invalid session value"
  [[ -d "$(dirname -- "${result_file}")" ]] ||
    die "diagnostic start result directory does not exist: $(dirname -- "${result_file}")"

  result_temp="$(mktemp -- "${result_file}.tmp.XXXXXX")" ||
    die "could not create diagnostic start result temporary file"
  chmod 0600 -- "${result_temp}" || {
    rm -f -- "${result_temp}"
    die "could not protect diagnostic start result temporary file"
  }
  if ! {
    echo 'format=go2-log-start-v1'
    echo "ownership=${ownership}"
    echo "session_id=${session_id}"
    echo "session_dir=${session_dir}"
  } > "${result_temp}"; then
    rm -f -- "${result_temp}"
    die "could not write diagnostic start result"
  fi
  if ! mv -f -- "${result_temp}" "${result_file}"; then
    rm -f -- "${result_temp}"
    die "could not publish diagnostic start result"
  fi
}

start_session() {
  local result_file="${1:-}"
  acquire_lock
  command -v python3 >/dev/null 2>&1 || die "python3 is required"

  local current pid writers
  if current="$(active_session_dir 2>/dev/null)"; then
    pid="$(read_first_line "${current}/collector.pid" 2>/dev/null || true)"
    if collector_is_running "${pid}" "${current}"; then
      record_active_runtime_overrides "${current}"
      write_start_result "${result_file}" existing "${current}"
      echo "Diagnostic session is already running: $(basename -- "${current}")"
      echo "Directory: ${current}"
      echo "Collector PID: ${pid}"
      return 0
    fi
    die "active diagnostic session is stale ($(basename -- "${current}")); run './tools/go2-log stop' before starting a new session"
  fi

  if ! writers="$(running_diagnostic_writers)"; then
    die "diagnostic writer process query failed before starting a session"
  fi
  if [[ -n "${writers}" ]]; then
    echo "${writers}" >&2
    die "live diagnostic writer exists without active-session state; inspect and stop it before starting a new session"
  fi

  cleanup_uploaded_sessions 19
  local session_count
  session_count="$(find "${SESSIONS_DIR}" -mindepth 1 -maxdepth 1 -type d -printf '.\n' | wc -l)"
  if (( session_count >= MAX_LOCAL_SESSIONS )); then
    die "${session_count} unuploaded sessions are retained; upload one before starting another"
  fi

  source_ros_environment
  command -v ros2 >/dev/null 2>&1 || die "ROS 2 Humble environment is required"
  command -v sync >/dev/null 2>&1 || die "GNU sync is required"
  sync --help 2>&1 | grep -Fq -- '--data' ||
    die "sync must support --data for durable topic-rate logging"
  python3 -c 'import rclpy; from nav_msgs.msg import Odometry' >/dev/null 2>&1 ||
    die "ROS 2 Python packages rclpy and nav_msgs are required"

  local host session_id session_dir temp_active collector_pid
  host="$(hostname -s | tr -d '\n' | tr -c 'A-Za-z0-9_.-' '-')"
  session_id="$(date -u +'%Y%m%dT%H%M%SZ')-${host}-$$"
  session_dir="${SESSIONS_DIR}/${session_id}"
  mkdir -m 0750 -- "${session_dir}"
  capture_static_context "${session_dir}" "${session_id}"

  temp_active="${ACTIVE_FILE}.tmp.$$"
  printf '%s\n' "${session_dir}" > "${temp_active}"
  mv -f -- "${temp_active}" "${ACTIVE_FILE}"

  nohup "${SCRIPT_DIR}/go2-log" _collect "${session_dir}" \
    >> "${session_dir}/collector.log" 2>&1 </dev/null &
  collector_pid="$!"
  printf '%s\n' "${collector_pid}" > "${session_dir}/collector.pid"

  sleep 1
  if ! collector_is_running "${collector_pid}" "${session_dir}"; then
    rm -f -- "${ACTIVE_FILE}"
    die "collector failed to start; see ${session_dir}/collector.log"
  fi

  write_start_result "${result_file}" created "${session_dir}"
  echo "Started diagnostic session: ${session_id}"
  echo "Directory: ${session_dir}"
  echo "Collector PID: ${collector_pid}"
}

status_session() {
  ensure_directories
  local session_dir pid size
  if session_dir="$(active_session_dir 2>/dev/null)"; then
    pid="$(read_first_line "${session_dir}/collector.pid" 2>/dev/null || true)"
    size="$(session_bytes "${session_dir}")"
    if collector_is_running "${pid}" "${session_dir}"; then
      echo "Status: running"
    else
      echo "Status: stale (collector is not running)"
    fi
    echo "Session: $(basename -- "${session_dir}")"
    echo "Directory: ${session_dir}"
    echo "Collector PID: ${pid:-unknown}"
    echo "Size: $(human_bytes "${size}") / 100 MiB"
  else
    echo "Status: stopped"
    local latest
    latest="$(find "${SESSIONS_DIR}" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | LC_ALL=C sort | tail -n 1)"
    [[ -z "${latest}" ]] || echo "Latest session: ${latest}"
  fi
}

stop_session() {
  acquire_lock
  local expected_session_id="${1:-}"
  local expected_session_dir=""
  local session_dir pid rosout_details rosout_pid rosout_boot rosout_start
  local timing_details timing_pid timing_boot timing_start
  local rosout_status timing_status writers all_writers
  if [[ -n "${expected_session_id}" ]]; then
    validate_session_id "${expected_session_id}"
    expected_session_dir="${SESSIONS_DIR}/${expected_session_id}"
  fi
  session_dir="$(active_session_dir 2>/dev/null)" || die "no active session"
  if [[ -n "${expected_session_id}" &&
        "${session_dir}" != "${expected_session_dir}" ]]; then
    die \
      "refusing to stop unexpected active diagnostic session: expected ${expected_session_dir}, active ${session_dir}"
  fi
  pid="$(read_first_line "${session_dir}/collector.pid" 2>/dev/null || true)"

  if ! collector_is_running "${pid}" "${session_dir}"; then
    if rosout_details="$(read_rosout_identity "${session_dir}" 2>/dev/null)"; then
      read -r rosout_pid rosout_boot rosout_start <<< "${rosout_details}"
      rosout_status=0
      stop_rosout_collector_process \
        "${rosout_pid}" "${rosout_boot}" "${rosout_start}" "${session_dir}" ||
        rosout_status=$?
      if (( rosout_status != 0 && rosout_status != 2 )); then
        die "stale collector has a verified rosout writer that could not be stopped; active state was preserved"
      fi
    fi
    if timing_details="$(read_timing_identity "${session_dir}" 2>/dev/null)"; then
      read -r timing_pid timing_boot timing_start <<< "${timing_details}"
      timing_status=0
      stop_timing_sampler_process \
        "${timing_pid}" "${timing_boot}" "${timing_start}" "${session_dir}" ||
        timing_status=$?
      if (( timing_status != 0 && timing_status != 2 )); then
        die "stale collector has a verified timing writer that could not be stopped; active state was preserved"
      fi
    fi
    if ! all_writers="$(running_diagnostic_writers)"; then
      die "diagnostic writer process query failed; active state was preserved"
    fi
    writers="$(grep -F -- "${session_dir}" <<< "${all_writers}" || true)"
    [[ -z "${writers}" ]] ||
      die "stale session still has a live diagnostic writer; active state was preserved"
    rm -f -- "${ACTIVE_FILE}"
    die "removed stale active-session state; collector was not running"
  fi

  kill -TERM "${pid}"
  for _ in {1..20}; do
    collector_is_running "${pid}" "${session_dir}" || break
    sleep 1
  done
  if collector_is_running "${pid}" "${session_dir}"; then
    die "collector did not stop within 20 seconds; inspect PID ${pid} before taking further action"
  fi

  if [[ -f "${ACTIVE_FILE}" ]] && [[ "$(< "${ACTIVE_FILE}")" == "${session_dir}" ]]; then
    die "collector stopped but writer cleanup did not complete; active state was preserved"
  fi
  if ! all_writers="$(running_diagnostic_writers)"; then
    die "diagnostic writer process query failed; active state was preserved"
  fi
  writers="$(grep -F -- "${session_dir}" <<< "${all_writers}" || true)"
  [[ -z "${writers}" ]] ||
    die "session still has a live diagnostic writer; active state was preserved"
  rm -f -- "${ACTIVE_FILE}"
  echo "Stopped diagnostic session: $(basename -- "${session_dir}")"
  echo "Directory: ${session_dir}"
}

lowcmd_publisher_count() {
  source_ros_environment
  command -v ros2 >/dev/null 2>&1 || {
    echo "ROS 2 command is unavailable while checking /lowcmd publishers." >&2
    return 1
  }

  local lowcmd_info='' lowcmd_status=0 publisher_count=''
  if lowcmd_info="$(
      timeout 8 ros2 topic info --no-daemon --spin-time 3 /lowcmd 2>&1
    )"; then
    lowcmd_status=0
  else
    lowcmd_status=$?
  fi

  if (( lowcmd_status != 0 )); then
    if (( lowcmd_status == 1 )) &&
      [[ "${lowcmd_info}" == "Unknown topic '/lowcmd'" ]]; then
      printf '0\n'
      return 0
    fi
    [[ -z "${lowcmd_info}" ]] || printf '%s\n' "${lowcmd_info}" >&2
    return 1
  fi

  publisher_count="$(
    awk -F': *' '$1 == "Publisher count" {print $2; exit}' <<< "${lowcmd_info}"
  )"
  [[ "${publisher_count}" =~ ^[0-9]+$ ]] || {
    [[ -z "${lowcmd_info}" ]] || printf '%s\n' "${lowcmd_info}" >&2
    return 1
  }
  printf '%s\n' "${publisher_count}"
}

assert_robot_idle() {
  local action="${1:-Git push}"
  local processes='' publisher_count=''
  if ! processes="$(checked_pgrep "${ROBOT_PROCESS_PATTERN}")"; then
    echo "Refusing ${action}: robot process query failed." >&2
    return 1
  fi
  if [[ -n "${processes}" ]]; then
    echo "Refusing ${action} while robot/SLAM/planning processes are running:" >&2
    echo "${processes}" >&2
    return 1
  fi

  if ! publisher_count="$(lowcmd_publisher_count)"; then
    echo "Refusing ${action}: /lowcmd publisher query failed." >&2
    return 1
  fi
  if (( publisher_count > 0 )); then
    echo \
      "Refusing ${action}: /lowcmd has ${publisher_count} publisher(s)." \
      >&2
    return 1
  fi
}

