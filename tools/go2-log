validate_planner_session() {
  local session_dir="$1"
  local session_parent sessions_parent session_id

  [[ -f "${ACTIVE_FILE}" && ! -L "${ACTIVE_FILE}" ]] ||
    die "active-session state is missing or symbolic"
  [[ -d "${session_dir}" && ! -L "${session_dir}" ]] ||
    die "active diagnostic session is invalid or symbolic"
  session_parent="$(cd -- "$(dirname -- "${session_dir}")" && pwd -P)"
  sessions_parent="$(cd -- "${SESSIONS_DIR}" && pwd -P)"
  [[ "${session_parent}" == "${sessions_parent}" ]] ||
    die "active diagnostic session is outside the sessions directory"
  session_id="$(basename -- "${session_dir}")"
  validate_session_id "${session_id}"
  [[ ! -e "${session_dir}/.uploaded" && ! -L "${session_dir}/.uploaded" ]] ||
    die "active diagnostic session is already marked uploaded"
  [[ ! -e "${session_dir}/ended_at.txt" && ! -L "${session_dir}/ended_at.txt" ]] ||
    die "active diagnostic session already has an end marker"
}

assert_planner_check_motion_idle() {
  local processes topic_list lowcmd_info publisher_count pgrep_status
  set +e
  processes="$(
    pgrep -af "${MOTION_PROCESS_PATTERN}" 2>/dev/null
  )"
  pgrep_status=$?
  set -e
  if (( pgrep_status > 1 )); then
    echo "Refusing planner check: motion process query failed." >&2
    return 1
  fi
  [[ ${pgrep_status} -eq 1 && -z "${processes}" ]] || {
    echo "Refusing planner check while a motion command process is running:" >&2
    echo "${processes}" >&2
    return 1
  }

  topic_list="$(
    timeout 8 ros2 topic list --no-daemon --spin-time 3 2>/dev/null
  )" || {
    echo "Refusing planner check: ROS graph query failed." >&2
    return 1
  }
  grep -Fxq '/lowcmd' <<< "${topic_list}" || return 0
  lowcmd_info="$(
    timeout 8 ros2 topic info --no-daemon --spin-time 3 -v /lowcmd 2>/dev/null
  )" || {
    echo "Refusing planner check: /lowcmd publisher query failed." >&2
    return 1
  }
  publisher_count="$(
    awk -F': *' '$1 == "Publisher count" {print $2; exit}' <<< "${lowcmd_info}"
  )"
  [[ "${publisher_count}" =~ ^[0-9]+$ ]] || {
    echo "Refusing planner check: /lowcmd publisher count is unavailable." >&2
    return 1
  }
  [[ "${publisher_count}" == 0 ]] || {
    echo "Refusing planner check: /lowcmd has ${publisher_count} publisher(s)." >&2
    return 1
  }
}

record_planner_inspection() {
  local session_dir="$1"
  local exit_code="$2"
  local result_file="$3"
  local error_file="$4"
  local log_path="${session_dir}/planner_input_inspections.jsonl"
  local size

  [[ "${exit_code}" =~ ^[0-9]+$ ]] || die "invalid planner-check exit code"
  size="$(session_bytes "${session_dir}")"
  (( size + PLANNER_RECORD_HEADROOM_BYTES < SESSION_STOP_BYTES )) ||
    die "session is too close to its size limit for another planner inspection"

  python3 - \
    "${REPO_ROOT}/tools" \
    "${log_path}" \
    "${LOG_ROOT}" \
    "${exit_code}" \
    "${result_file}" \
    "${error_file}" \
    "${PLANNER_SERIES_ID}" \
    "${PLANNER_SERIES_INDEX}" \
    "${PLANNER_SERIES_COUNT}" \
    "${PLANNER_SERIES_INTERVAL_SEC}" <<'PY'
import json
from pathlib import Path
import sys

(
    tools_dir,
    log_name,
    temporary_directory,
    raw_exit,
    result_name,
    error_name,
    series_id,
    raw_series_index,
    raw_series_count,
    raw_series_interval,
) = sys.argv[1:]
sys.path.insert(0, tools_dir)
from inspect_planner_inputs import _write_session_record_atomic  # noqa: E402

exit_code = int(raw_exit)
result_text = Path(result_name).read_text(encoding="utf-8", errors="replace")
error_text = Path(error_name).read_text(encoding="utf-8", errors="replace")
inspection = None

def reject_constant(value):
    raise ValueError(f"invalid JSON numeric constant: {value}")

try:
    candidate = json.loads(
        result_text,
        parse_constant=reject_constant,
    )
    if isinstance(candidate, dict) and isinstance(candidate.get("diagnosis"), str):
        inspection = candidate
except (json.JSONDecodeError, ValueError):
    pass

if exit_code in {0, 2} and inspection is not None:
    if series_id:
        inspection["series"] = {
            "id": series_id,
            "index": int(raw_series_index),
            "count": int(raw_series_count),
            "interval_sec": float(raw_series_interval),
        }
    _write_session_record_atomic(
        Path(log_name),
        Path(temporary_directory),
        exit_code,
        inspection=inspection,
    )
    print(f"Planner inspection recorded: {log_name}")
    print(f"Diagnosis: {inspection['diagnosis']}")
else:
    message = error_text.strip() or result_text.strip()
    if not message:
        message = f"inspector exited {exit_code} without diagnostic output"
    _write_session_record_atomic(
        Path(log_name),
        Path(temporary_directory),
        1,
        error={
            "type": "inspector_capture_error",
            "message": message[:65536],
        },
    )
    print(f"Planner inspection capture error recorded: {log_name}", file=sys.stderr)
    raise SystemExit(1)
PY
}

planner_check() {
  local session_dir collector_pid current
  local inspector_status tee_status postflight_error=''
  local -a pipeline_status=()

  session_dir="$(active_session_dir 2>/dev/null)" ||
    die "no active diagnostic session; run ./tools/go2-log start first"
  validate_planner_session "${session_dir}"
  collector_pid="$(read_first_line "${session_dir}/collector.pid" 2>/dev/null || true)"
  collector_is_running "${collector_pid}" "${session_dir}" ||
    die "active diagnostic collector is not healthy"
  (( $(session_bytes "${session_dir}") + PLANNER_RECORD_HEADROOM_BYTES <
      SESSION_STOP_BYTES )) ||
    die "session is too close to its size limit for another planner inspection"
  [[ -r "${REPO_ROOT}/tools/inspect_planner_inputs.py" ]] ||
    die "planner input inspector is missing from ${REPO_ROOT}/tools"
  [[ -r "${REPO_ROOT}/shell/ros2_environment.sh" ]] ||
    die "ROS 2 environment helper is missing from ${REPO_ROOT}/shell"

  # shellcheck disable=SC1091
  source "${REPO_ROOT}/shell/ros2_environment.sh"
  command -v ros2 >/dev/null 2>&1 || die "ros2 is unavailable"
  assert_planner_check_motion_idle || die "motion safety preflight failed"

  trap go2_log_exit_cleanup EXIT
  PLANNER_RESULT_FILE="$(mktemp --tmpdir go2-planner-result.XXXXXX)"
  PLANNER_ERROR_FILE="$(mktemp --tmpdir go2-planner-error.XXXXXX)"

  set +e
  {
    (
      ulimit -f $((COMMAND_CAPTURE_BYTES / 1024))
      exec python3 "${REPO_ROOT}/tools/inspect_planner_inputs.py" --json \
        --record-start-on-goal-timeout \
        --read-live-parameters \
        "$@"
    ) > "${PLANNER_RESULT_FILE}"
  } 2>&1 | (
    ulimit -f $((COMMAND_CAPTURE_BYTES / 1024))
    exec tee -- "${PLANNER_ERROR_FILE}" >&2
  )
  pipeline_status=("${PIPESTATUS[@]}")
  set -e
  inspector_status="${pipeline_status[0]:-1}"
  tee_status="${pipeline_status[1]:-1}"
  if (( ${#pipeline_status[@]} != 2 || tee_status != 0 )); then
    printf '%s\n' 'planner-check stderr streaming failed' >&2
    printf '%s\n' 'planner-check stderr streaming failed' \
      > "${PLANNER_ERROR_FILE}"
    : > "${PLANNER_RESULT_FILE}"
    inspector_status=1
  fi

  if ! postflight_error="$(assert_planner_check_motion_idle 2>&1)"; then
    {
      printf 'post-capture motion safety preflight failed\n'
      printf '%s\n' "${postflight_error}"
    } | tee "${PLANNER_ERROR_FILE}" >&2
    : > "${PLANNER_RESULT_FILE}"
    inspector_status=1
  fi

  acquire_lock
  current="$(active_session_dir 2>/dev/null)" ||
    die "diagnostic session stopped before planner inspection could be recorded"
  [[ "${current}" == "${session_dir}" ]] ||
    die "active diagnostic session changed during planner inspection"
  validate_planner_session "${session_dir}"
  collector_pid="$(read_first_line "${session_dir}/collector.pid" 2>/dev/null || true)"
  collector_is_running "${collector_pid}" "${session_dir}" ||
    die "diagnostic collector stopped before planner inspection could be recorded"
  record_planner_inspection \
    "${session_dir}" "${inspector_status}" \
    "${PLANNER_RESULT_FILE}" "${PLANNER_ERROR_FILE}"
  cleanup_planner_temporaries
  return "${inspector_status}"
}

validate_planner_series_schedule() {
  python3 - "$1" "$2" <<'PY'
import math
import re
import sys

raw_samples, raw_interval = sys.argv[1:]
if re.fullmatch(r"[0-9]+", raw_samples) is None:
    raise SystemExit("samples must be an integer from 2 through 30")
samples = int(raw_samples)
if not 2 <= samples <= 30:
    raise SystemExit("samples must be an integer from 2 through 30")

if re.fullmatch(
    r"[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?",
    raw_interval,
) is None:
    raise SystemExit("interval must be a finite number from 0.5 through 5 seconds")
interval = float(raw_interval)
if not math.isfinite(interval) or not 0.5 <= interval <= 5.0:
    raise SystemExit("interval must be a finite number from 0.5 through 5 seconds")
if (samples - 1) * interval > 30.0:
    raise SystemExit("planned series span must not exceed 30 seconds")

print(f"{samples}\t{interval!r}")
PY
}

planner_series() {
  local samples=10 interval_sec=1.0 index inspector_status aggregate_status=0
  local no_goal=false has_goal_x=false has_goal_y=false argument
  local schedule_values
  local -a inspector_arguments=()

  while (( $# > 0 )); do
    case "$1" in
      --samples)
        (( $# >= 2 )) || die "planner-series --samples requires a value"
        samples="$2"
        shift 2
        ;;
      --samples=*)
        samples="${1#*=}"
        shift
        ;;
      --interval)
        (( $# >= 2 )) || die "planner-series --interval requires a value"
        interval_sec="$2"
        shift 2
        ;;
      --interval=*)
        interval_sec="${1#*=}"
        shift
        ;;
      *)
        inspector_arguments+=("$1")
        shift
        ;;
    esac
  done

  command -v python3 >/dev/null 2>&1 || die "python3 is required"
  if ! schedule_values="$(
    validate_planner_series_schedule "${samples}" "${interval_sec}"
  )"; then
    die "invalid planner-series schedule"
  fi
  IFS=$'\t' read -r samples interval_sec <<< "${schedule_values}"

  for argument in "${inspector_arguments[@]}"; do
    case "${argument}" in
      --no-goal)
        no_goal=true
        ;;
      --goal-x|--goal-x=*)
        has_goal_x=true
        ;;
      --goal-y|--goal-y=*)
        has_goal_y=true
        ;;
    esac
  done
  if [[ "${no_goal}" == true ]]; then
    [[ "${has_goal_x}" == false && "${has_goal_y}" == false ]] ||
      die "planner-series --no-goal cannot be combined with manual goal coordinates"
  elif [[ "${has_goal_x}" != true || "${has_goal_y}" != true ]]; then
    die "planner-series requires --no-goal or both --goal-x and --goal-y"
  fi

  PLANNER_SERIES_ID="$(date -u +'%Y%m%dT%H%M%SZ')-$$"
  PLANNER_SERIES_COUNT="${samples}"
  PLANNER_SERIES_INTERVAL_SEC="${interval_sec}"

  for (( index = 1; index <= samples; index++ )); do
    PLANNER_SERIES_INDEX="${index}"
    set +e
    (set -e; planner_check "${inspector_arguments[@]}")
    inspector_status=$?
    set -e
    case "${inspector_status}" in
      0)
        ;;
      2)
        aggregate_status=2
        ;;
      *)
        return "${inspector_status}"
        ;;
    esac
    if (( index < samples )); then
      sleep "${interval_sec}"
    fi
  done

  echo "Planner series complete: ${samples}/${samples} samples"
  return "${aggregate_status}"
}

