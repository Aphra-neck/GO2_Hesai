#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

resolve_repository_root() {
  local script_parent candidate
  script_parent="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
  if [[ -n "${GO2_WORKSPACE:-}" ]]; then
    candidate="${GO2_WORKSPACE}"
  elif git -C "${script_parent}" rev-parse --show-toplevel >/dev/null 2>&1; then
    candidate="$(git -C "${script_parent}" rev-parse --show-toplevel)"
  elif git -C "${PWD}" rev-parse --show-toplevel >/dev/null 2>&1; then
    candidate="$(git -C "${PWD}" rev-parse --show-toplevel)"
  else
    candidate="${PWD}"
  fi
  if [[ ! -d "${candidate}" ]]; then
    echo "go2-log: workspace directory does not exist: ${candidate}" >&2
    return 1
  fi
  (cd -- "${candidate}" && pwd)
}

REPO_ROOT="$(resolve_repository_root)"
LOG_ROOT="${GO2_LOG_ROOT:-${HOME}/go2_logs}"
SESSIONS_DIR="${LOG_ROOT}/sessions"
ACTIVE_FILE="${LOG_ROOT}/active_session"
LOCK_DIR="${LOG_ROOT}/.command-lock"
LOCK_OWNER_FILE="${LOCK_DIR}/owner"
LOG_REPO="${GO2_LOG_REPO:-${HOME}/G02_log}"
LOG_REMOTE="${GO2_LOG_REMOTE:-https://github.com/Aphra-neck/G02_log.git}"
LOG_BRANCH="${GO2_LOG_BRANCH:-main}"
LOG_PROXY="${GO2_LOG_PROXY:-http://192.168.151.132:7890}"

# Leave room for the independently bounded rosout and parameter-capture writers.
readonly SESSION_STOP_BYTES=$((36 * 1024 * 1024))
readonly SESSION_FINAL_BYTES=$((94 * 1024 * 1024))
readonly SESSION_MAX_BYTES=$((100 * 1024 * 1024))
readonly MAX_GIT_FILE_BYTES=$((40 * 1024 * 1024))
readonly COMMAND_CAPTURE_BYTES=$((4 * 1024 * 1024))
readonly PLANNER_RECORD_HEADROOM_BYTES=$((1 * 1024 * 1024))
readonly TOPIC_TIMING_MAX_BYTES=$((4 * 1024 * 1024))
readonly HESAI_TAIL_BYTES=$((256 * 1024))
readonly MAX_LOCAL_SESSIONS=20

PLANNER_RESULT_FILE=''
PLANNER_ERROR_FILE=''
PLANNER_SERIES_ID=''
PLANNER_SERIES_INDEX=''
PLANNER_SERIES_COUNT=''
PLANNER_SERIES_INTERVAL_SEC=''

# Bracket the first character so concurrent pgrep queries cannot match each other.
readonly ROBOT_PROCESS_PATTERN='[h]esai_ros_driver_node|[g]o2_imu_bridge_node|[s]uper_lio_node|[b]ody_odom_adapter_node|[t]errain_mapper_node|[b]ody_lattice_planner_node|[g]o2_sdk2_bridge_node|[g]o2_sdk2_direct_bridge_node|[g]o2_sdk2_simple_nav_node|[r]l_controller_node|[u]tree_go2_rl_controller'
readonly MOTION_PROCESS_PATTERN='[g]o2_sdk2_bridge_node|[g]o2_sdk2_direct_bridge_node|[g]o2_sdk2_simple_nav_node|[r]l_controller_node|[u]tree_go2_rl_controller'

declare -ar COMPONENT_SPECS=(
  'hesai_lidar:[h]esai_ros_driver_node'
  'go2_imu_bridge:[g]o2_imu_bridge_node'
  'super_lio:[s]uper_lio_node'
  'body_odom_adapter:[b]ody_odom_adapter_node'
  'terrain_mapper:[t]errain_mapper_node'
  'body_lattice_planner:[b]ody_lattice_planner_node'
  'go2_sdk2_bridge:[g]o2_sdk2_bridge_node'
  'go2_sdk2_direct_bridge:[g]o2_sdk2_direct_bridge_node'
  'go2_rl_controller:[r]l_controller_node|[u]tree_go2_rl_controller'
)

declare -ar REPAIRABLE_SESSION_TEXT_FILES=(
  'topic_rates.csv'
  'odom_position.csv'
  'body_odom_pose.csv'
  'sdk2_commands.csv'
  'process_health.csv'
  'topic_timing.csv'
  'system_health.csv'
  'network_health.csv'
  'hesai_summary.csv'
  'events.jsonl'
  'planner_input_inspections.jsonl'
  'rosout_warn_error.txt'
  'collector.log'
)

die() {
  echo "go2-log: $*" >&2
  exit 1
}

utc_now() {
  date -u +'%Y-%m-%dT%H:%M:%SZ'
}

ensure_directories() {
  mkdir -p -- "${SESSIONS_DIR}"
}

process_start_ticks() {
  local pid="$1"
  [[ -r "/proc/${pid}/stat" ]] || return 1
  local stat_line stat_tail
  local -a stat_fields=()
  IFS= read -r stat_line < "/proc/${pid}/stat" || return 1
  # The comm field is parenthesized and may itself contain spaces or ')'.
  # Strip through its final delimiter; starttime is field 20 of the tail
  # because the tail begins with the process state (the kernel's field 3).
  stat_tail="${stat_line##*) }"
  read -r -a stat_fields <<< "${stat_tail}"
  (( ${#stat_fields[@]} >= 20 )) || return 1
  [[ "${stat_fields[19]}" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "${stat_fields[19]}"
}

process_state() {
  local pid="$1"
  [[ -r "/proc/${pid}/stat" ]] || return 1
  local stat_line stat_tail
  IFS= read -r stat_line < "/proc/${pid}/stat" || return 1
  stat_tail="${stat_line##*) }"
  [[ -n "${stat_tail}" ]] || return 1
  printf '%s\n' "${stat_tail%% *}"
}

boot_id() {
  read_first_line /proc/sys/kernel/random/boot_id
}

lock_owner_is_live() {
  [[ -r "${LOCK_OWNER_FILE}" ]] || return 1
  local key value owner_pid='' owner_boot='' owner_start=''
  while IFS='=' read -r key value; do
    case "${key}" in
      pid) owner_pid="${value}" ;;
      boot_id) owner_boot="${value}" ;;
      start_ticks) owner_start="${value}" ;;
    esac
  done < "${LOCK_OWNER_FILE}"

  [[ "${owner_pid}" =~ ^[1-9][0-9]*$ && -n "${owner_boot}" && -n "${owner_start}" ]] || return 1
  [[ "$(boot_id 2>/dev/null || true)" == "${owner_boot}" ]] || return 1
  kill -0 "${owner_pid}" 2>/dev/null || return 1
  [[ "$(process_start_ticks "${owner_pid}" 2>/dev/null || true)" == "${owner_start}" ]] || return 1
  [[ -r "/proc/${owner_pid}/cmdline" ]] || return 1
  local command_line
  command_line="$(tr '\0' ' ' < "/proc/${owner_pid}/cmdline")"
  [[ "${command_line}" == *"go2-log"* ]]
}

release_lock() {
  [[ -d "${LOCK_DIR}" && -r "${LOCK_OWNER_FILE}" ]] || return 0
  local owner_pid
  owner_pid="$(awk -F= '$1 == "pid" {print $2; exit}' "${LOCK_OWNER_FILE}")"
  [[ "${owner_pid}" == "$$" ]] || return 0
  rm -f -- "${LOCK_OWNER_FILE}"
  rmdir -- "${LOCK_DIR}" 2>/dev/null || true
}

cleanup_planner_temporaries() {
  if [[ -n "${PLANNER_RESULT_FILE}" ]]; then
    rm -f -- "${PLANNER_RESULT_FILE}"
    PLANNER_RESULT_FILE=''
  fi
  if [[ -n "${PLANNER_ERROR_FILE}" ]]; then
    rm -f -- "${PLANNER_ERROR_FILE}"
    PLANNER_ERROR_FILE=''
  fi
}

go2_log_exit_cleanup() {
  cleanup_planner_temporaries
  release_lock
}

acquire_lock() {
  ensure_directories
  local attempt stale_dir age_seconds modified_at owner_pid
  for attempt in 1 2 3; do
    if mkdir -- "${LOCK_DIR}" 2>/dev/null; then
      local owner_temp="${LOCK_OWNER_FILE}.tmp.$$"
      {
        echo "pid=$$"
        echo "boot_id=$(boot_id)"
        echo "start_ticks=$(process_start_ticks "$$")"
        echo "created_at=$(utc_now)"
      } > "${owner_temp}"
      mv -f -- "${owner_temp}" "${LOCK_OWNER_FILE}"
      trap go2_log_exit_cleanup EXIT
      return 0
    fi

    if lock_owner_is_live; then
      owner_pid="$(awk -F= '$1 == "pid" {print $2; exit}' "${LOCK_OWNER_FILE}")"
      die "another go2-log command is running (PID ${owner_pid})"
    fi

    # Do not reclaim a directory while its owner file may still be initialized.
    modified_at="$(stat -c '%Y' -- "${LOCK_DIR}" 2>/dev/null || echo 0)"
    age_seconds=$(( $(date +%s) - modified_at ))
    if [[ ! -r "${LOCK_OWNER_FILE}" && ${age_seconds} -lt 10 ]]; then
      die "another go2-log command is initializing its lock"
    fi

    stale_dir="${LOCK_DIR}.stale.$$-${attempt}"
    if mv -- "${LOCK_DIR}" "${stale_dir}" 2>/dev/null; then
      find "${stale_dir}" -mindepth 1 -maxdepth 1 -type f -delete
      rmdir -- "${stale_dir}" || die "stale lock contains unexpected entries: ${stale_dir}"
    fi
  done
  die "could not acquire the go2-log command lock"
}

checked_pgrep() {
  local pattern="$1"
  local matches='' status=0
  if matches="$(pgrep -af -- "${pattern}" 2>/dev/null)"; then
    status=0
  else
    status=$?
  fi
  case "${status}" in
    0)
      [[ -n "${matches}" ]] || return 2
      printf '%s\n' "${matches}"
      ;;
    1)
      [[ -z "${matches}" ]] || return 2
      ;;
    *)
      return 2
      ;;
  esac
}

session_bytes() {
  local session_dir="$1"
  du -sb -- "${session_dir}" 2>/dev/null | awk '{print $1}' || echo 0
}

human_bytes() {
  local bytes="$1"
  if command -v numfmt >/dev/null 2>&1; then
    numfmt --to=iec-i --suffix=B "${bytes}"
  else
    echo "${bytes} bytes"
  fi
}

cap_text_file() {
  local path="$1"
  local max_bytes="${2:-${COMMAND_CAPTURE_BYTES}}"
  [[ -f "${path}" && ! -L "${path}" ]] || return 0
  local size
  size="$(stat -c '%s' -- "${path}" 2>/dev/null || echo 0)"
  (( size > max_bytes )) || return 0

  python3 - "${path}" "${max_bytes}" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
limit = int(sys.argv[2])
marker = b"\n[go2-log: capture truncated to preserve the session size limit]\n"
with path.open("rb") as stream:
    data = stream.read(limit)
prefix = data[: max(0, limit - len(marker))].decode("utf-8", errors="replace").encode("utf-8")
while len(prefix) + len(marker) > limit:
    prefix = prefix[:-1]
temporary = path.with_name(path.name + ".bounded.tmp")
temporary.write_bytes(prefix + marker)
temporary.replace(path)
PY
}

enforce_session_size_limit() {
  local session_dir="$1"
  local size protect_repair_outputs=false
  if [[ -f "${session_dir}/repair_manifest.jsonl" && ! -L "${session_dir}/repair_manifest.jsonl" ]]; then
    protect_repair_outputs=true
  fi
  size="$(session_bytes "${session_dir}")"
  (( size <= SESSION_FINAL_BYTES )) && return 0

  printf '%s session captures were trimmed on approach to the 100 MiB safety ceiling\n' \
    "$(utc_now)" > "${session_dir}/capacity_reached.txt"
  if [[ "${protect_repair_outputs}" != true ]]; then
    cap_text_file "${session_dir}/rosout_warn_error.txt" $((16 * 1024 * 1024))
    cap_text_file "${session_dir}/collector.log" $((4 * 1024 * 1024))
  fi

  local path
  for path in git.txt ros_dds_environment.txt network.txt system.txt topics.txt nodes.txt capacity_reached.txt; do
    cap_text_file "${session_dir}/${path}" $((1 * 1024 * 1024))
  done
  while IFS= read -r -d '' path; do
    cap_text_file "${path}" $((512 * 1024))
  done < <(find "${session_dir}" -maxdepth 1 -type f -name 'parameters_*.yaml' -print0)
  for path in topic_rates.csv odom_position.csv body_odom_pose.csv sdk2_commands.csv process_health.csv topic_timing.csv system_health.csv network_health.csv hesai_summary.csv events.jsonl; do
    [[ "${protect_repair_outputs}" != true ]] || continue
    cap_text_file "${session_dir}/${path}" $((8 * 1024 * 1024))
  done

  # Deterministically shrink only collector-owned text outputs. Unknown files
  # are never altered; they remain subject to the upload payload validator.
  python3 - "${session_dir}" $((93 * 1024 * 1024)) <<'PY'
from pathlib import Path
import os
import sys

root = Path(sys.argv[1])
target = int(sys.argv[2])
owned_names = {
    "git.txt", "ros_dds_environment.txt", "network.txt", "system.txt",
    "topics.txt", "nodes.txt", "rosout_warn_error.txt", "collector.log",
    "topic_rates.csv", "odom_position.csv", "body_odom_pose.csv", "sdk2_commands.csv",
    "process_health.csv", "topic_timing.csv", "system_health.csv",
    "network_health.csv", "hesai_summary.csv", "events.jsonl",
    "capacity_reached.txt", "topic_timing_capacity_reached.txt",
    "rosout.identity", "timing.identity",
}
repair_protected_names = {
    "topic_rates.csv", "odom_position.csv", "body_odom_pose.csv",
    "sdk2_commands.csv", "process_health.csv", "topic_timing.csv",
    "system_health.csv", "network_health.csv", "hesai_summary.csv", "events.jsonl",
    "rosout_warn_error.txt", "collector.log",
}
protect_repair_outputs = (root / "repair_manifest.jsonl").is_file()

def files() -> list[Path]:
    return [path for path in root.rglob("*") if path.is_file() and not path.is_symlink()]

def is_owned_text(path: Path) -> bool:
    relative = path.relative_to(root)
    if len(relative.parts) == 1:
        if protect_repair_outputs and path.name in repair_protected_names:
            return False
        return path.name in owned_names or (
            path.name.startswith("parameters_") and path.suffix in {".yaml", ".tmp"}
        )
    return relative.parts[0] == "analysis" and path.suffix.lower() in {".md", ".csv", ".txt", ".json", ".jsonl"}

current = sum(path.stat().st_size for path in files())
marker = b"\n[go2-log: content trimmed to preserve the session size ceiling]\n"
while current > target:
    candidates = sorted(
        (path for path in files() if is_owned_text(path) and path.stat().st_size > 4096),
        key=lambda path: path.stat().st_size,
        reverse=True,
    )
    if not candidates:
        break
    path = candidates[0]
    old_size = path.stat().st_size
    requested = max(4096, old_size - (current - target) - 1024 * 1024)
    with path.open("rb") as stream:
        data = stream.read(requested)
    prefix = data[: max(0, requested - len(marker))].decode("utf-8", errors="replace").encode("utf-8")
    while len(prefix) + len(marker) > requested:
        prefix = prefix[:-1]
    temporary = path.with_name(path.name + ".bounded.tmp")
    temporary.write_bytes(prefix + marker)
    temporary.replace(path)
    current -= old_size - path.stat().st_size

if current > target:
    print("collector-owned text could not be compacted below the hard ceiling", file=sys.stderr)
    raise SystemExit(1)
PY

  size="$(session_bytes "${session_dir}")"
  if (( size > SESSION_FINAL_BYTES )); then
    echo "go2-log: session still exceeds the 94 MiB finalized-session ceiling" >&2
    return 1
  fi
}

collector_is_running() {
  local pid="$1"
  local session_dir="$2"
  [[ "${pid}" =~ ^[1-9][0-9]*$ ]] || return 1
  kill -0 "${pid}" 2>/dev/null || return 1
  [[ -r "/proc/${pid}/cmdline" ]] || return 1

  local command_line
  command_line="$(tr '\0' ' ' < "/proc/${pid}/cmdline")"
  [[ "${command_line}" == *"go2-log"* ]] &&
    [[ "${command_line}" == *"_collect"* ]] &&
    [[ "${command_line}" == *"${session_dir}"* ]]
}

diagnostic_writer_identity_matches() {
  local pid="$1"
  local expected_boot_id="$2"
  local expected_start_ticks="$3"
  local session_dir="$4"
  local subcommand="$5"
  [[ "${pid}" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ -n "${expected_boot_id}" && "${expected_start_ticks}" =~ ^[0-9]+$ ]] || return 1
  [[ -n "${session_dir}" && "${subcommand}" == _* ]] || return 1
  [[ "$(boot_id 2>/dev/null || true)" == "${expected_boot_id}" ]] || return 1
  kill -0 "${pid}" 2>/dev/null || return 1
  [[ "$(process_start_ticks "${pid}" 2>/dev/null || true)" == "${expected_start_ticks}" ]] || return 1
  [[ -r "/proc/${pid}/cmdline" ]] || return 1

  local command_line
  command_line="$(tr '\0' ' ' < "/proc/${pid}/cmdline")"
  [[ "${command_line}" == *"go2-log"* ]] &&
    [[ "${command_line}" == *"${subcommand}"* ]] &&
    [[ "${command_line}" == *"${session_dir}"* ]]
}

rosout_identity_matches() {
  diagnostic_writer_identity_matches "$@" _rosout
}

timing_identity_matches() {
  diagnostic_writer_identity_matches "$@" _timing
}

write_diagnostic_writer_identity() {
  local session_dir="$1"
  local pid="$2"
  local captured_boot_id="$3"
  local captured_start_ticks="$4"
  local writer_name="$5"
  local pgid identity_file temporary
  pgid="$(ps -o pgid= -p "${pid}" 2>/dev/null | tr -d '[:space:]' || true)"
  identity_file="${session_dir}/${writer_name}.identity"
  temporary="${identity_file}.tmp.$$"
  {
    echo "pid=${pid}"
    echo "boot_id=${captured_boot_id}"
    echo "start_ticks=${captured_start_ticks}"
    echo "pgid=${pgid:-unknown}"
    echo "session_dir=${session_dir}"
    echo "writer=${writer_name}"
    echo "collector_pid=$$"
    echo "captured_at=$(utc_now)"
  } > "${temporary}"
  mv -f -- "${temporary}" "${identity_file}"
}

write_rosout_identity() {
  write_diagnostic_writer_identity "$@" rosout
}

write_timing_identity() {
  write_diagnostic_writer_identity "$@" timing
}

capture_diagnostic_writer_identity() {
  local pid="$1"
  local session_dir="$2"
  local writer_name="$3"
  local subcommand="$4"
  local attempt captured_boot_id captured_start_ticks
  for (( attempt = 0; attempt < 100; attempt++ )); do
    captured_boot_id="$(boot_id 2>/dev/null || true)"
    captured_start_ticks="$(process_start_ticks "${pid}" 2>/dev/null || true)"
    if diagnostic_writer_identity_matches \
      "${pid}" "${captured_boot_id}" "${captured_start_ticks}" \
      "${session_dir}" "${subcommand}"; then
      write_diagnostic_writer_identity \
        "${session_dir}" "${pid}" "${captured_boot_id}" \
        "${captured_start_ticks}" "${writer_name}"
      printf '%s %s\n' "${captured_boot_id}" "${captured_start_ticks}"
      return 0
    fi
    kill -0 "${pid}" 2>/dev/null || return 1
    sleep 0.02
  done
  return 1
}

capture_rosout_identity() {
  capture_diagnostic_writer_identity "$@" rosout _rosout
}

capture_timing_identity() {
  capture_diagnostic_writer_identity "$@" timing _timing
}

read_recorded_writer_pgid() {
  local session_dir="$1"
  local writer_name="$2"
  local expected_pid="$3"
  local expected_boot_id="$4"
  local expected_start_ticks="$5"
  local identity_file="${session_dir}/${writer_name}.identity"
  [[ -f "${identity_file}" && ! -L "${identity_file}" ]] || return 1

  local key value pid='' captured_boot_id='' captured_start_ticks=''
  local pgid='' recorded_session='' recorded_writer=''
  while IFS='=' read -r key value; do
    case "${key}" in
      pid) pid="${value}" ;;
      boot_id) captured_boot_id="${value}" ;;
      start_ticks) captured_start_ticks="${value}" ;;
      pgid) pgid="${value}" ;;
      session_dir) recorded_session="${value}" ;;
      writer) recorded_writer="${value}" ;;
    esac
  done < "${identity_file}"
  [[ "${pid}" == "${expected_pid}" ]] || return 1
  [[ "${captured_boot_id}" == "${expected_boot_id}" ]] || return 1
  [[ "${captured_start_ticks}" == "${expected_start_ticks}" ]] || return 1
  [[ "${pgid}" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ "${recorded_session}" == "${session_dir}" ]] || return 1
  [[ -z "${recorded_writer}" || "${recorded_writer}" == "${writer_name}" ]] || return 1
  printf '%s\n' "${pgid}"
}

stop_diagnostic_writer_process() {
  local pid="$1"
  local expected_boot_id="$2"
  local expected_start_ticks="$3"
  local session_dir="$4"
  local subcommand="$5"
  local writer_name="${subcommand#_}"
  local recorded_pgid=''
  recorded_pgid="$(read_recorded_writer_pgid \
    "${session_dir}" "${writer_name}" "${pid}" "${expected_boot_id}" \
    "${expected_start_ticks}" 2>/dev/null || true)"

  # Once the identity anchor is gone, never signal its old group: the numeric
  # PGID may have been reused. A still-existing recorded group is fail-closed.
  if ! kill -0 "${pid}" 2>/dev/null; then
    wait "${pid}" 2>/dev/null || true
    if [[ "${recorded_pgid}" =~ ^[1-9][0-9]*$ ]] &&
      kill -0 -- "-${recorded_pgid}" 2>/dev/null; then
      return 1
    fi
    return 0
  fi

  local pgid leader_state
  leader_state="$(process_state "${pid}" 2>/dev/null || true)"
  pgid="$(ps -o pgid= -p "${pid}" 2>/dev/null | tr -d '[:space:]' || true)"
  if [[ "${leader_state}" == Z ]]; then
    # A zombie has no cmdline, so anchor the group to its still-live kernel
    # identity. Requiring a session leader prevents signalling a group which
    # was inherited from an unrelated parent.
    [[ "$(boot_id 2>/dev/null || true)" == "${expected_boot_id}" ]] || return 2
    [[ "$(process_start_ticks "${pid}" 2>/dev/null || true)" == "${expected_start_ticks}" ]] ||
      return 2
    [[ "${pgid}" == "${pid}" ]] || return 2
    [[ "${recorded_pgid}" == "${pgid}" ]] || return 2
  else
    diagnostic_writer_identity_matches \
      "${pid}" "${expected_boot_id}" "${expected_start_ticks}" \
      "${session_dir}" "${subcommand}" || return 2
    if [[ -n "${recorded_pgid}" && "${recorded_pgid}" != "${pgid}" ]]; then
      return 2
    fi
  fi

  # Close the check-to-signal window as much as shell APIs allow. Never signal
  # after any identity field changes, even if the numeric PID is still live.
  if [[ "${leader_state}" == Z ]]; then
    [[ "$(boot_id 2>/dev/null || true)" == "${expected_boot_id}" ]] || return 2
    [[ "$(process_start_ticks "${pid}" 2>/dev/null || true)" == "${expected_start_ticks}" ]] ||
      return 2
    [[ "$(process_state "${pid}" 2>/dev/null || true)" == Z ]] || return 2
    [[ "$(ps -o pgid= -p "${pid}" 2>/dev/null | tr -d '[:space:]' || true)" == "${pgid}" ]] ||
      return 2
  else
    diagnostic_writer_identity_matches \
      "${pid}" "${expected_boot_id}" "${expected_start_ticks}" \
      "${session_dir}" "${subcommand}" || return 2
  fi
  if [[ "${pgid}" == "${pid}" ]]; then
    kill -TERM -- "-${pid}" 2>/dev/null || return 1
  else
    kill -TERM "${pid}" 2>/dev/null || return 1
  fi
  for _ in {1..50}; do
    if [[ "${pgid}" == "${pid}" ]]; then
      if ! kill -0 -- "-${pgid}" 2>/dev/null; then
        wait "${pid}" 2>/dev/null || true
        return 0
      fi
    elif ! diagnostic_writer_identity_matches \
      "${pid}" "${expected_boot_id}" "${expected_start_ticks}" \
      "${session_dir}" "${subcommand}"; then
      wait "${pid}" 2>/dev/null || true
      return 0
    fi
    if [[ "$(process_state "${pid}" 2>/dev/null || true)" == Z ]]; then
      # Reap only when this shell is the parent. A surviving same-PGID child
      # keeps the group probe alive, so reaping the leader cannot mask it.
      wait "${pid}" 2>/dev/null || true
    fi
    sleep 0.1
  done
  wait "${pid}" 2>/dev/null || true
  if [[ "${pgid}" == "${pid}" ]]; then
    kill -0 -- "-${pgid}" 2>/dev/null && return 1
  elif diagnostic_writer_identity_matches \
    "${pid}" "${expected_boot_id}" "${expected_start_ticks}" \
    "${session_dir}" "${subcommand}"; then
    return 1
  fi
  return 0
}

stop_rosout_collector_process() {
  stop_diagnostic_writer_process "$@" _rosout
}

stop_timing_sampler_process() {
  stop_diagnostic_writer_process "$@" _timing
}

read_diagnostic_writer_identity() {
  local session_dir="$1"
  local writer_name="$2"
  local identity_file="${session_dir}/${writer_name}.identity"
  [[ -f "${identity_file}" && ! -L "${identity_file}" ]] || return 1
  local key value pid='' captured_boot_id='' captured_start_ticks=''
  local recorded_session='' recorded_writer=''
  while IFS='=' read -r key value; do
    case "${key}" in
      pid) pid="${value}" ;;
      boot_id) captured_boot_id="${value}" ;;
      start_ticks) captured_start_ticks="${value}" ;;
      session_dir) recorded_session="${value}" ;;
      writer) recorded_writer="${value}" ;;
    esac
  done < "${identity_file}"
  [[ "${pid}" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ "${captured_start_ticks}" =~ ^[0-9]+$ ]] || return 1
  [[ -n "${captured_boot_id}" && "${recorded_session}" == "${session_dir}" ]] || return 1
  [[ -z "${recorded_writer}" || "${recorded_writer}" == "${writer_name}" ]] || return 1
  printf '%s %s %s\n' "${pid}" "${captured_boot_id}" "${captured_start_ticks}"
}

read_rosout_identity() {
  read_diagnostic_writer_identity "$1" rosout
}

read_timing_identity() {
  read_diagnostic_writer_identity "$1" timing
}

active_session_dir() {
  [[ -f "${ACTIVE_FILE}" ]] || return 1
  local session_dir
  IFS= read -r session_dir < "${ACTIVE_FILE}"
  [[ -n "${session_dir}" && -d "${session_dir}" ]] || return 1
  printf '%s\n' "${session_dir}"
}

read_first_line() {
  local path="$1"
  local value=''
  [[ -r "${path}" ]] || return 1
  IFS= read -r value < "${path}" || [[ -n "${value}" ]]
  printf '%s\n' "${value}"
}

append_event() {
  local session_dir="$1"
  local level="$2"
  local category="$3"
  local message="$4"

  (( $(session_bytes "${session_dir}") < SESSION_STOP_BYTES )) || return 0
  python3 - "${session_dir}/events.jsonl" "${level}" "${category}" "${message}" <<'PY'
import datetime
import json
import sys

path, level, category, message = sys.argv[1:]
record = {
    "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "level": level,
    "category": category,
    "message": message,
}
with open(path, "a", encoding="utf-8") as stream:
    stream.write(json.dumps(record, ensure_ascii=True, separators=(",", ":")) + "\n")
PY
}

