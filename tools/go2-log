record_active_runtime_overrides() {
  local session_dir="$1"
  local body_yaw_offset="${GO2_BODY_YAW_OFFSET_RAD:-}"
  local lio_dense_output="${GO2_LIO_DENSE_OUTPUT:-}"
  local recorded_dense_output=''

  if [[ -n "${body_yaw_offset}" ]]; then
    if [[ "${body_yaw_offset}" =~ ^[-+]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][-+]?[0-9]+)?$ ]]; then
      printf 'GO2_BODY_YAW_OFFSET_RAD=%s\n' "${body_yaw_offset}" \
        >> "${session_dir}/ros_dds_environment.txt"
    else
      append_event "${session_dir}" warning configuration \
        "ignored invalid GO2_BODY_YAW_OFFSET_RAD from a repeated start command"
    fi
  fi

  if [[ -n "${lio_dense_output}" ]]; then
    case "${lio_dense_output}" in
      true|false)
        if recorded_dense_output="$(
          read_recorded_environment_value \
            "${session_dir}" GO2_LIO_DENSE_OUTPUT
        )"; then
          case "${recorded_dense_output}" in
            true|false) ;;
            *)
              die "active diagnostic session has an invalid recorded GO2_LIO_DENSE_OUTPUT"
              ;;
          esac
          if [[ "${recorded_dense_output}" != "${lio_dense_output}" ]]; then
            die "active diagnostic session uses GO2_LIO_DENSE_OUTPUT=${recorded_dense_output}; stop it before changing to ${lio_dense_output}"
          fi
        else
          printf 'GO2_LIO_DENSE_OUTPUT=%s\n' "${lio_dense_output}" \
            >> "${session_dir}/ros_dds_environment.txt"
        fi
        ;;
      *)
        append_event "${session_dir}" warning configuration \
          "ignored invalid GO2_LIO_DENSE_OUTPUT from a repeated start command"
        ;;
    esac
  fi
}

