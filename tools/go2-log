  local result rate status timestamp
  timestamp="$(utc_now)"

  if ! command -v ros2 >/dev/null 2>&1; then
    rate=''
    status=ros_unavailable
  else
    result="$(LC_ALL=C timeout 4 ros2 topic hz "${topic}" --window 100 2>&1 || true)"
    rate="$(awk '/average rate:/ {value=$3} END {print value}' <<< "${result}")"
    if [[ "${rate}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
      status=ok
    else
      rate=''
      status=no_data
    fi
  fi

  printf '%s,%s,%s,%s\n' "${timestamp}" "${topic}" "${rate}" "${status}" \
    >> "${session_dir}/topic_rates.csv"
  if ! sync --data -- "${session_dir}/topic_rates.csv"; then
    echo "go2-log: failed to fdatasync ${session_dir}/topic_rates.csv" >&2
    return 1
  fi
}

sample_odometry_pair() {
  local session_dir="$1"
  local timestamp
  timestamp="$(utc_now)"
  if ! timeout 5 python3 - \
    "${session_dir}/odom_position.csv" \
    "${session_dir}/body_odom_pose.csv" \
    "${timestamp}" <<'PY'
import csv
import math
from pathlib import Path
import sys
import time

import rclpy
from nav_msgs.msg import Odometry
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data

raw_path = Path(sys.argv[1])
body_path = Path(sys.argv[2])
captured_at = sys.argv[3]
topics = ("/lio/odom", "/lio/body_odom")
message_buffers = {topic: {} for topic in topics}
latest_messages = {}
node = None


def blank_row(topic, status):
    return [captured_at, topic, "", "", "", "", "", "", "", "", "", "", "", status]


def encode(topic, message, status_override=None):
    if message is None:
        return blank_row(topic, "no_data")
    position = message.pose.pose.position
    orientation = message.pose.pose.orientation
    values = [
        float(position.x), float(position.y), float(position.z),
        float(orientation.x), float(orientation.y),
        float(orientation.z), float(orientation.w),
    ]
    stamp = message.header.stamp
    stamp_ns = int(stamp.sec) * 1_000_000_000 + int(stamp.nanosec)
    norm_squared = sum(value * value for value in values[3:])
    status = "ok"
    yaw = ""
    if (
        not all(math.isfinite(value) for value in values)
        or not math.isfinite(norm_squared)
        or abs(norm_squared - 1.0) > 1.0e-3
        or stamp_ns <= 0
        or not 0 <= int(stamp.nanosec) < 1_000_000_000
    ):
        status = "invalid_message"
    else:
        norm = math.sqrt(norm_squared)
        qx, qy, qz, qw = (value / norm for value in values[3:])
        yaw = math.atan2(
            2.0 * (qw * qz + qx * qy),
            1.0 - 2.0 * (qy * qy + qz * qz),
        )
        if status_override is not None:
            status = status_override
    return [
        captured_at,
        topic,
        str(stamp_ns),
        message.header.frame_id,
        message.child_frame_id,
        *values,
        yaw,
        status,
    ]


def valid_stamp_ns(message):
    stamp = message.header.stamp
    nanosec = int(stamp.nanosec)
    stamp_ns = int(stamp.sec) * 1_000_000_000 + nanosec
    if stamp_ns <= 0 or not 0 <= nanosec < 1_000_000_000:
        return None
    return stamp_ns


def store(topic):
    def callback(message):
        latest_messages[topic] = message
        stamp_ns = valid_stamp_ns(message)
        if stamp_ns is None:
            return
        buffer = message_buffers[topic]
        buffer[stamp_ns] = message
        while len(buffer) > 64:
            del buffer[min(buffer)]
    return callback


try:
    rclpy.init(args=None)
    node = Node("go2_log_odometry_sampler")
    subscriptions = [
        node.create_subscription(
            Odometry,
            topic,
            store(topic),
            qos_profile_sensor_data,
        )
        for topic in topics
    ]
    deadline = time.monotonic() + 3.0
    matched_stamp = None
    while time.monotonic() < deadline:
        rclpy.spin_once(node, timeout_sec=0.1)
        common_stamps = set(message_buffers[topics[0]]).intersection(
            message_buffers[topics[1]]
        )
        if common_stamps:
            matched_stamp = max(common_stamps)
            break
    if matched_stamp is None:
        rows = [
            encode(topic, latest_messages.get(topic), "unpaired_stamp")
            for topic in topics
        ]
    else:
        rows = [
            encode(topic, message_buffers[topic][matched_stamp])
            for topic in topics
        ]
except Exception as exception:
    print(f"go2-log odometry sampler failed: {exception}", file=sys.stderr)
    rows = [blank_row(topic, "sampler_error") for topic in topics]
finally:
    if node is not None:
        node.destroy_node()
    if rclpy.ok():
        rclpy.shutdown()

for path, row in zip((raw_path, body_path), rows):
    with path.open("a", encoding="utf-8", newline="") as stream:
        csv.writer(stream, lineterminator="\n").writerow(row)
PY
  then
    append_event "${session_dir}" warning collector \
      "odometry sampler timed out or failed before writing samples"
    python3 - \
      "${session_dir}/odom_position.csv" \
      "${session_dir}/body_odom_pose.csv" \
      "${timestamp}" <<'PY'
import csv
from pathlib import Path
import sys

for path, topic in zip(map(Path, sys.argv[1:3]), ("/lio/odom", "/lio/body_odom")):
    row = [sys.argv[3], topic, "", "", "", "", "", "", "", "", "", "", "", "sampler_error"]
    with path.open("a", encoding="utf-8", newline="") as stream:
        csv.writer(stream, lineterminator="\n").writerow(row)
PY
  fi
}

