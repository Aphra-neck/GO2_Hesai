sample_process_health() {
  local session_dir="$1"
  local timestamp="$2"
  local spec component pattern pids running previous
  declare -n previous_states_ref="$3"

  for spec in "${COMPONENT_SPECS[@]}"; do
    component="${spec%%:*}"
    pattern="${spec#*:}"
    pids="$(pgrep -f "${pattern}" 2>/dev/null | paste -sd ';' - || true)"
    if [[ -n "${pids}" ]]; then
      running=1
    else
      running=0
    fi
    printf '%s,%s,%s,%s\n' "${timestamp}" "${component}" "${running}" "${pids}" \
      >> "${session_dir}/process_health.csv"

    previous="${previous_states_ref[${component}]:-unknown}"
    if [[ "${previous}" != "${running}" ]]; then
      if [[ "${running}" == 1 ]]; then
        append_event "${session_dir}" info lifecycle "${component} started (pids=${pids})"
      elif [[ "${previous}" != unknown ]]; then
        append_event "${session_dir}" warning lifecycle "${component} stopped"
      fi
      previous_states_ref["${component}"]="${running}"
    fi
  done
}

run_rosout_collector() {
  local session_dir="$1"
  command -v ros2 >/dev/null 2>&1 || exit 0

  # A 32 MiB per-file ceiling stays inside the headroom above the stop threshold.
  ulimit -f 32768 2>/dev/null || true
  ros2 topic echo /rosout 2>/dev/null | awk '
    BEGIN { RS="---[[:space:]]*\n"; ORS="---\n" }
    /(^|\n)level: (30|40|50)(\n|$)/ { print; fflush() }
  ' >> "${session_dir}/rosout_warn_error.txt"
}

run_collector() {
  local session_dir="$1"
  local session_id
  session_id="$(basename -- "${session_dir}")"
  source_ros_environment

  local stop_requested=0
  local rosout_pid=''
  local rosout_boot_id=''
  local rosout_start_ticks=''
  # Passed by name to sample_process_health via Bash's declare -n.
  # shellcheck disable=SC2034
  declare -A previous_states=()

  request_stop() {
    stop_requested=1
  }

  finish_collector() {
    if [[ -n "${rosout_pid}" ]]; then
      local rosout_stop_status=0
      stop_rosout_collector_process \
        "${rosout_pid}" "${rosout_boot_id}" "${rosout_start_ticks}" "${session_dir}" ||
        rosout_stop_status=$?
      if (( rosout_stop_status == 2 )); then
        append_event "${session_dir}" warning collector \
          "rosout identity mismatch for PID ${rosout_pid}; no signal was sent"
      elif (( rosout_stop_status != 0 )); then
        append_event "${session_dir}" warning collector \
          "failed to stop the verified rosout process PID ${rosout_pid}"
      fi
      rosout_pid=''
    fi
    append_event "${session_dir}" info collector "collector stopped"
    printf '%s\n' "$(utc_now)" > "${session_dir}/ended_at.txt"
    enforce_session_size_limit "${session_dir}" ||
      echo "WARNING: preserve the oversized session with SCP: ${session_dir}" >&2
    if [[ -f "${ACTIVE_FILE}" ]] && [[ "$(< "${ACTIVE_FILE}")" == "${session_dir}" ]]; then
      rm -f -- "${ACTIVE_FILE}"
    fi
  }

  trap request_stop INT TERM
  trap finish_collector EXIT

  if command -v setsid >/dev/null 2>&1 && command -v ros2 >/dev/null 2>&1; then
    setsid "${SCRIPT_DIR}/go2-log" _rosout "${session_dir}" &
    rosout_pid="$!"
    printf '%s\n' "${rosout_pid}" > "${session_dir}/rosout.pid"
    local rosout_identity
    if rosout_identity="$(capture_rosout_identity "${rosout_pid}" "${session_dir}")"; then
      read -r rosout_boot_id rosout_start_ticks <<< "${rosout_identity}"
    else
      append_event "${session_dir}" warning collector \
        "could not capture the complete rosout identity for PID ${rosout_pid}"
    fi
  fi

  append_event "${session_dir}" info collector "collector started"
  local graph_cycle=0 size timestamp topic
  while (( stop_requested == 0 )); do
    size="$(session_bytes "${session_dir}")"
    if (( size >= SESSION_STOP_BYTES )); then
      printf '%s session collection stopped at %s to enforce the 100 MiB limit\n' \
        "$(utc_now)" "$(human_bytes "${size}")" > "${session_dir}/capacity_reached.txt"
      break
    fi

    timestamp="$(utc_now)"
    sample_process_health "${session_dir}" "${timestamp}" previous_states

    if (( graph_cycle % 4 == 0 )); then
      capture_ros_graph "${session_dir}"
    fi
    graph_cycle=$((graph_cycle + 1))

    for topic in /imu/data /lio/odom /lio/body_odom /body_path /terrain_costmap /sdk2_command; do
      (( stop_requested == 0 )) || break
      (( $(session_bytes "${session_dir}") < SESSION_STOP_BYTES )) || break
      sample_topic_rate "${session_dir}" "${topic}"
    done
    (( stop_requested == 0 )) || break
    sample_odometry_pair "${session_dir}"
    (( stop_requested == 0 )) || break
    sample_sdk2_command "${session_dir}"

    local slept=0
    while (( slept < 10 && stop_requested == 0 )); do
      sleep 1
      slept=$((slept + 1))
    done
  done

  # On a normal return, run cleanup while this function's local state is still
  # in scope. The EXIT trap remains the fallback for errors and abrupt exits.
  finish_collector
  trap - EXIT INT TERM
}

start_session() {
  acquire_lock
  command -v python3 >/dev/null 2>&1 || die "python3 is required"

  local current pid
  if current="$(active_session_dir 2>/dev/null)"; then
    pid="$(read_first_line "${current}/collector.pid" 2>/dev/null || true)"
    if collector_is_running "${pid}" "${current}"; then
      record_active_runtime_overrides "${current}"
      echo "Diagnostic session is already running: $(basename -- "${current}")"
      echo "Directory: ${current}"
      echo "Collector PID: ${pid}"
      return 0
    fi
    rm -f -- "${ACTIVE_FILE}"
  fi

  cleanup_uploaded_sessions 19
  local session_count
  session_count="$(find "${SESSIONS_DIR}" -mindepth 1 -maxdepth 1 -type d -printf '.\n' | wc -l)"
  if (( session_count >= MAX_LOCAL_SESSIONS )); then
    die "${session_count} unuploaded sessions are retained; upload one before starting another"
  fi

  source_ros_environment
  command -v ros2 >/dev/null 2>&1 || die "ROS 2 Humble environment is required"
  command -v sync >/dev/null 2>&1 || die "GNU sync is required"
  sync --help 2>&1 | grep -Fq -- '--data' ||
    die "sync must support --data for durable topic-rate logging"
  python3 -c 'import rclpy; from nav_msgs.msg import Odometry' >/dev/null 2>&1 ||
    die "ROS 2 Python packages rclpy and nav_msgs are required"

  local host session_id session_dir temp_active collector_pid
  host="$(hostname -s | tr -d '\n' | tr -c 'A-Za-z0-9_.-' '-')"
  session_id="$(date -u +'%Y%m%dT%H%M%SZ')-${host}-$$"
  session_dir="${SESSIONS_DIR}/${session_id}"
  mkdir -m 0750 -- "${session_dir}"
  capture_static_context "${session_dir}" "${session_id}"

  temp_active="${ACTIVE_FILE}.tmp.$$"
  printf '%s\n' "${session_dir}" > "${temp_active}"
  mv -f -- "${temp_active}" "${ACTIVE_FILE}"

  nohup "${SCRIPT_DIR}/go2-log" _collect "${session_dir}" \
    >> "${session_dir}/collector.log" 2>&1 </dev/null &
  collector_pid="$!"
  printf '%s\n' "${collector_pid}" > "${session_dir}/collector.pid"

  sleep 1
  if ! collector_is_running "${collector_pid}" "${session_dir}"; then
    rm -f -- "${ACTIVE_FILE}"
    die "collector failed to start; see ${session_dir}/collector.log"
  fi

  echo "Started diagnostic session: ${session_id}"
  echo "Directory: ${session_dir}"
  echo "Collector PID: ${collector_pid}"
}

status_session() {
  ensure_directories
  local session_dir pid size
  if session_dir="$(active_session_dir 2>/dev/null)"; then
    pid="$(read_first_line "${session_dir}/collector.pid" 2>/dev/null || true)"
    size="$(session_bytes "${session_dir}")"
    if collector_is_running "${pid}" "${session_dir}"; then
      echo "Status: running"
    else
      echo "Status: stale (collector is not running)"
    fi
    echo "Session: $(basename -- "${session_dir}")"
    echo "Directory: ${session_dir}"
    echo "Collector PID: ${pid:-unknown}"
    echo "Size: $(human_bytes "${size}") / 100 MiB"
  else
    echo "Status: stopped"
    local latest
    latest="$(find "${SESSIONS_DIR}" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | LC_ALL=C sort | tail -n 1)"
    [[ -z "${latest}" ]] || echo "Latest session: ${latest}"
  fi
}

stop_session() {
  acquire_lock
  local session_dir pid rosout_details rosout_pid rosout_boot rosout_start
  local rosout_status writers
  session_dir="$(active_session_dir 2>/dev/null)" || die "no active session"
  pid="$(read_first_line "${session_dir}/collector.pid" 2>/dev/null || true)"

  if ! collector_is_running "${pid}" "${session_dir}"; then
    if rosout_details="$(read_rosout_identity "${session_dir}" 2>/dev/null)"; then
      read -r rosout_pid rosout_boot rosout_start <<< "${rosout_details}"
      rosout_status=0
      stop_rosout_collector_process \
        "${rosout_pid}" "${rosout_boot}" "${rosout_start}" "${session_dir}" ||
        rosout_status=$?
      if (( rosout_status != 0 && rosout_status != 2 )); then
        die "stale collector has a verified rosout writer that could not be stopped"
      fi
    fi
    writers="$(running_diagnostic_writers | grep -F -- "${session_dir}" || true)"
    [[ -z "${writers}" ]] ||
      die "stale session still has a live diagnostic writer; active state was preserved"
    rm -f -- "${ACTIVE_FILE}"
    die "removed stale active-session state; collector was not running"
  fi

  kill -TERM "${pid}"
  for _ in {1..20}; do
    collector_is_running "${pid}" "${session_dir}" || break
    sleep 1
  done
  if collector_is_running "${pid}" "${session_dir}"; then
    die "collector did not stop within 20 seconds; inspect PID ${pid} before taking further action"
  fi

  rm -f -- "${ACTIVE_FILE}"
  echo "Stopped diagnostic session: $(basename -- "${session_dir}")"
  echo "Directory: ${session_dir}"
}

running_robot_processes() {
  pgrep -af "${ROBOT_PROCESS_PATTERN}" 2>/dev/null || true
}

assert_robot_idle() {
  local action="${1:-Git push}"
  local processes
