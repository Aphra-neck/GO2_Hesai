validate_session_for_upload() {
  local session_dir="$1"
  local allow_oversized_text="${2:-false}"
  [[ -d "${session_dir}" && ! -L "${session_dir}" ]] || die "invalid session directory: ${session_dir}"
  local size
  size="$(session_bytes "${session_dir}")"
  if [[ "${allow_oversized_text}" != true ]]; then
    (( size <= SESSION_MAX_BYTES )) || die "session exceeds 100 MiB; preserve it with SCP instead of Git"
  fi

  local max_file_bytes="${MAX_GIT_FILE_BYTES}"
  [[ "${allow_oversized_text}" != true ]] || max_file_bytes=0
  if ! python3 - "${session_dir}" "${max_file_bytes}" <<'PY'
from pathlib import Path
import os
import re
import stat
import sys

root = Path(sys.argv[1])
max_file_bytes = int(sys.argv[2])
artifact_pattern = re.compile(
    r"(?:^|\.)(?:pcd|ply|las|bag|bag2|db3|sqlite3|mcap|pcap)(?:\.|$)", re.IGNORECASE
)
archive_suffixes = (
    ".zip", ".7z", ".rar", ".tar", ".tgz", ".gz", ".bz2", ".xz", ".zst", ".lz4"
)
binary_magic = (
    b"\x7fELF", b"PK\x03\x04", b"\x1f\x8b", b"BZh", b"\xfd7zXZ\x00",
    b"(\xb5/\xfd", b"7z\xbc\xaf'\x1c", b"Rar!\x1a\x07", b"SQLite format 3\x00",
    b"\x89PNG\r\n\x1a\n", b"\xff\xd8\xff", b"GIF87a", b"GIF89a", b"%PDF-",
)
allowed_controls = {9, 10, 12, 13, 27}

def reject(message: str) -> None:
    print(f"go2-log payload rejection: {message}", file=sys.stderr)
    raise SystemExit(1)

for directory, dirnames, filenames in os.walk(root, followlinks=False):
    directory_path = Path(directory)
    for dirname in list(dirnames):
        path = directory_path / dirname
        if path.is_symlink():
            reject(f"symbolic-link directory: {path.relative_to(root)}")
    for filename in filenames:
        path = directory_path / filename
        relative = path.relative_to(root)
        mode = path.lstat().st_mode
        if stat.S_ISLNK(mode) or not stat.S_ISREG(mode):
            reject(f"non-regular file: {relative}")
        lower_name = filename.lower()
        if artifact_pattern.search(lower_name) or re.match(r"^core(?:\.|$)", lower_name):
            reject(f"runtime artifact filename: {relative}")
        if lower_name.endswith(archive_suffixes):
            reject(f"archive/compressed filename: {relative}")
        size = path.stat().st_size
        if max_file_bytes and size > max_file_bytes:
            reject(f"file exceeds {max_file_bytes} bytes: {relative} ({size} bytes)")
        if size == 0:
            continue
        controls = 0
        inspected = 0
        first = b""
        with path.open("rb") as stream:
            while True:
                chunk = stream.read(1024 * 1024)
                if not chunk:
                    break
                if not first:
                    first = chunk[:4096]
                    if any(first.startswith(magic) for magic in binary_magic):
                        reject(f"binary file signature: {relative}")
                    if b"FIELDS " in first and b"POINTS " in first and b"DATA " in first:
                        reject(f"PCD content: {relative}")
                if b"\x00" in chunk:
                    reject(f"NUL-containing binary file: {relative}")
                controls += sum(byte < 32 and byte not in allowed_controls for byte in chunk)
                inspected += len(chunk)
        if controls > 16 and controls * 100 > inspected:
            reject(f"binary control-byte content: {relative}")
PY
  then
    die "session contains a forbidden or unsafe Git payload: ${session_dir}"
  fi
}

validate_repair_evidence() {
  local session_dir="$1"
  if ! python3 - \
    "${session_dir}" \
    "${LOG_ROOT}" \
    "${MAX_GIT_FILE_BYTES}" \
    "${REPAIRABLE_SESSION_TEXT_FILES[@]}" <<'PY'
from pathlib import Path
import hashlib
import json
import os
import re
import stat
import sys

session = Path(sys.argv[1])
log_root = Path(sys.argv[2])
max_file_bytes = int(sys.argv[3])
allowed_names = set(sys.argv[4:])
session_id = session.name
manifest = session / "repair_manifest.jsonl"
hash_pattern = re.compile(r"^[0-9a-f]{64}$")
effective_uid = os.geteuid()
manifest_fields = {
    "file",
    "original_sha256",
    "original_size",
    "quarantine_file",
    "repaired_at",
    "repaired_sha256",
    "repaired_size",
    "trailing_nul_bytes",
}


def reject(message: str) -> None:
    print(f"go2-log repair evidence rejection: {message}", file=sys.stderr)
    raise SystemExit(1)


def owned_directory(path: Path, description: str, missing_ok: bool = False):
    try:
        metadata = path.lstat()
    except FileNotFoundError:
        if missing_ok:
            return False
        reject(f"{description} is missing: {path}")
    if (
        stat.S_ISLNK(metadata.st_mode)
        or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != effective_uid
    ):
        reject(f"{description} is not an owned directory: {path}")
    return True


def read_owned_file(path: Path, description: str, limit: int):
    try:
        metadata = path.lstat()
    except FileNotFoundError:
        reject(f"{description} is missing: {path}")
    if (
        stat.S_ISLNK(metadata.st_mode)
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != effective_uid
    ):
        reject(f"{description} is not an owned regular file: {path}")
    if metadata.st_size > limit:
        reject(f"{description} exceeds {limit} bytes: {path}")
    data = path.read_bytes()
    after = path.lstat()
    if (
        metadata.st_dev,
        metadata.st_ino,
        metadata.st_size,
        metadata.st_mtime_ns,
        metadata.st_ctime_ns,
    ) != (
        after.st_dev,
        after.st_ino,
        after.st_size,
        after.st_mtime_ns,
        after.st_ctime_ns,
    ):
        reject(f"{description} changed while being read: {path}")
    return data


def validate_record(record, line_number: int):
    if not isinstance(record, dict) or set(record) != manifest_fields:
        reject(f"invalid manifest schema at line {line_number}")
    if record["file"] not in allowed_names:
        reject(f"invalid repaired filename at line {line_number}")
    for key in ("original_sha256", "repaired_sha256"):
        if not isinstance(record[key], str) or not hash_pattern.fullmatch(record[key]):
            reject(f"invalid {key} at line {line_number}")
    for key in ("original_size", "repaired_size", "trailing_nul_bytes"):
        if not isinstance(record[key], int) or isinstance(record[key], bool) or record[key] < 0:
            reject(f"invalid {key} at line {line_number}")
    if (
        record["trailing_nul_bytes"] <= 0
        or record["repaired_size"] + record["trailing_nul_bytes"]
        != record["original_size"]
        or record["original_size"] > max_file_bytes
    ):
        reject(f"inconsistent sizes at line {line_number}")
    if not isinstance(record["repaired_at"], str) or not record["repaired_at"]:
        reject(f"invalid repaired_at at line {line_number}")
    expected_quarantine = (
        f"quarantine/{session_id}/{record['file']}."
        f"{record['original_sha256']}.corrupt"
    )
    if record["quarantine_file"] != expected_quarantine:
        reject(f"invalid quarantine path at line {line_number}")
    return record


owned_directory(log_root, "diagnostics root")
owned_directory(session, "session")
quarantine_root = log_root / "quarantine"
quarantine = quarantine_root / session_id

if not manifest.exists() and not manifest.is_symlink():
    if owned_directory(quarantine, "session quarantine", missing_ok=True):
        unfinished = sorted(
            path.name
            for path in quarantine.iterdir()
            if path.name.endswith(".repair.json") or path.name.endswith(".corrupt")
        )
        if unfinished:
            reject("quarantine evidence exists without a repair manifest; run go2-log repair")
    raise SystemExit(0)

manifest_data = read_owned_file(manifest, "repair manifest", 1024 * 1024)
if not manifest_data or not manifest_data.endswith(b"\n"):
    reject("repair manifest is empty or lacks a final newline")
try:
    manifest_text = manifest_data.decode("utf-8")
except UnicodeDecodeError:
    reject("repair manifest is not valid UTF-8")

owned_directory(quarantine_root, "quarantine root")
owned_directory(quarantine, "session quarantine")
records = []
record_keys = set()
for line_number, line in enumerate(manifest_text.splitlines(), 1):
    try:
        record = validate_record(json.loads(line), line_number)
    except json.JSONDecodeError:
        reject(f"invalid repair manifest JSON at line {line_number}")
    key = (record["file"], record["original_sha256"])
    if key in record_keys:
        reject(f"duplicate manifest record at line {line_number}")
    record_keys.add(key)
    records.append(record)

expected_journals = {
    f"{record['file']}.{record['original_sha256']}.repair.json"
    for record in records
}
expected_originals = {
    f"{record['file']}.{record['original_sha256']}.corrupt"
    for record in records
}
actual_journals = {
    path.name for path in quarantine.iterdir() if path.name.endswith(".repair.json")
}
actual_originals = {
    path.name for path in quarantine.iterdir() if path.name.endswith(".corrupt")
}
if actual_journals != expected_journals or actual_originals != expected_originals:
    reject("manifest, repair journals, and quarantined originals do not match")

latest_clean = {}
for record in records:
    name = record["file"]
    original_name = f"{name}.{record['original_sha256']}.corrupt"
    journal_name = f"{name}.{record['original_sha256']}.repair.json"
    original = read_owned_file(
        quarantine / original_name,
        "quarantined original",
        max_file_bytes,
    )
    if (
        len(original) != record["original_size"]
        or hashlib.sha256(original).hexdigest() != record["original_sha256"]
    ):
        reject(f"quarantined original hash or size mismatch: {name}")
    clean = original[: record["repaired_size"]]
    suffix = original[record["repaired_size"] :]
    if (
        len(suffix) != record["trailing_nul_bytes"]
        or not suffix
        or any(suffix)
        or not clean.endswith(b"\n")
        or hashlib.sha256(clean).hexdigest() != record["repaired_sha256"]
    ):
        reject(f"quarantined original is not the recorded trailing-NUL repair: {name}")
    try:
        clean.decode("utf-8")
    except UnicodeDecodeError:
        reject(f"recorded repaired text is not valid UTF-8: {name}")
    previous = latest_clean.get(name)
    if previous is not None and not clean.startswith(previous):
        reject(f"repair history is not append-only: {name}")
    latest_clean[name] = clean

    journal_data = read_owned_file(
        quarantine / journal_name,
        "repair journal",
        1024 * 1024,
    )
    try:
        journal = json.loads(journal_data.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        reject(f"invalid repair journal JSON: {journal_name}")
    expected_journal = dict(record, state="completed")
    if journal != expected_journal:
        reject(f"repair journal is not completed or disagrees with manifest: {name}")

for name, clean in latest_clean.items():
    current = read_owned_file(
        session / name,
        "repaired session file",
        max_file_bytes,
    )
    if current != clean:
        reject(f"repaired session file no longer matches completed evidence: {name}")
PY
  then
    die "session repair evidence is incomplete or inconsistent: ${session_dir}"
  fi
}

git_with_proxy() {
  git -c "http.proxy=${LOG_PROXY}" -c "https.proxy=${LOG_PROXY}" "$@"
}

canonical_git_remote() {
  python3 - "$1" <<'PY'
import os
import posixpath
import re
import sys
from urllib.parse import unquote, urlsplit

value = sys.argv[1].strip()
if not value or any(character in value for character in "\r\n\0"):
    raise SystemExit("invalid empty or multiline Git remote")

scp = re.fullmatch(r"(?:([^@/:]+)@)?([^/:]+):(.+)", value)
if scp and "://" not in value:
    host = scp.group(2).lower()
    path = scp.group(3)
    if "?" in path or "#" in path:
        raise SystemExit("Git remote query strings and fragments are forbidden")
    kind = "remote"
else:
    parsed = urlsplit(value)
    if parsed.query or parsed.fragment:
        raise SystemExit("Git remote query strings and fragments are forbidden")
    if parsed.scheme in {"http", "https"}:
        if parsed.username is not None or parsed.password is not None:
            raise SystemExit("embedded HTTP Git credentials are forbidden")
        host = (parsed.hostname or "").lower()
        port = parsed.port
        default_port = 80 if parsed.scheme == "http" else 443
        path = unquote(parsed.path)
        kind = "remote"
    elif parsed.scheme in {"ssh", "git"}:
        if parsed.password is not None:
            raise SystemExit("embedded SSH password is forbidden")
        host = (parsed.hostname or "").lower()
        port = parsed.port
        default_port = 22 if parsed.scheme == "ssh" else 9418
        path = unquote(parsed.path)
        kind = "remote"
    elif parsed.scheme == "file":
        if parsed.hostname not in (None, "", "localhost"):
            raise SystemExit("non-local file:// Git remote is forbidden")
        print("local:" + os.path.realpath(os.path.expanduser(unquote(parsed.path))))
        raise SystemExit(0)
    elif parsed.scheme:
        raise SystemExit(f"unsupported Git remote scheme: {parsed.scheme}")
    else:
        print("local:" + os.path.realpath(os.path.expanduser(value)))
        raise SystemExit(0)

if not host:
    raise SystemExit("Git remote has no host")
path = posixpath.normpath("/" + path).lstrip("/")
if path.lower().endswith(".git"):
    path = path[:-4]
if not path or path == ".":
    raise SystemExit("Git remote has no repository path")
if host == "github.com":
    path = path.lower()
if 'port' in locals() and port not in (None, default_port):
    host = f"{host}:{port}"
print(f"remote:{host}/{path}")
PY
}

assert_log_remote_identity() {
  local expected actual canonical
  if ! expected="$(canonical_git_remote "${LOG_REMOTE}")"; then
    die "GO2_LOG_REMOTE is invalid or embeds credentials"
  fi
  local -a urls=()
  mapfile -t urls < <(git -C "${LOG_REPO}" remote get-url --all origin 2>/dev/null || true)
  (( ${#urls[@]} > 0 )) || die "log repository has no origin fetch URL"
  for actual in "${urls[@]}"; do
    canonical="$(canonical_git_remote "${actual}")" || die "origin has an invalid fetch URL"
    [[ "${canonical}" == "${expected}" ]] ||
      die "origin fetch URL is not GO2_LOG_REMOTE (${canonical} != ${expected})"
  done
  urls=()
  mapfile -t urls < <(git -C "${LOG_REPO}" remote get-url --push --all origin 2>/dev/null || true)
  (( ${#urls[@]} > 0 )) || die "log repository has no origin push URL"
  for actual in "${urls[@]}"; do
    canonical="$(canonical_git_remote "${actual}")" || die "origin has an invalid push URL"
    [[ "${canonical}" == "${expected}" ]] ||
      die "origin push URL is not GO2_LOG_REMOTE (${canonical} != ${expected})"
  done
  LOG_REMOTE_IDENTITY="${expected}"
}

ensure_log_repository_identity() {
  local name email source_name source_email
  name="$(git -C "${LOG_REPO}" config --local --get user.name 2>/dev/null || true)"
  email="$(git -C "${LOG_REPO}" config --local --get user.email 2>/dev/null || true)"
  [[ -n "${name}" && -n "${email}" ]] && return 0

  source_name="$(git -C "${REPO_ROOT}" show -s --format='%an' HEAD 2>/dev/null || true)"
  source_email="$(git -C "${REPO_ROOT}" show -s --format='%ae' HEAD 2>/dev/null || true)"
  if [[ -z "${source_name}" || -z "${source_email}" ]]; then
    die "log repository has no local Git identity and the GO2_Hesai commit author could not be read"
  fi

  if [[ -z "${name}" ]]; then
    git -C "${LOG_REPO}" config --local user.name "${source_name}"
  fi
  if [[ -z "${email}" ]]; then
    git -C "${LOG_REPO}" config --local user.email "${source_email}"
  fi
}

assert_local_commits_are_diagnostic_only() {
  local upstream="$1"
  local commit path
  while IFS= read -r commit; do
    [[ -n "${commit}" ]] || continue
    while IFS= read -r -d '' path; do
      [[ "${path}" == sessions/* ]] ||
        die "local log-repository commit contains unrelated path: ${path}"
    done < <(git -C "${LOG_REPO}" diff-tree --root --no-commit-id --name-only -r -z "${commit}")
  done < <(git -C "${LOG_REPO}" rev-list "${upstream}..HEAD")
}

prepare_log_repository() {
  local session_id="$1"
  local parent expected unrelated session_path destination
  command -v python3 >/dev/null 2>&1 || die "python3 is required"
  expected="$(canonical_git_remote "${LOG_REMOTE}")" ||
    die "GO2_LOG_REMOTE is invalid or embeds credentials"
  if [[ ! -d "${LOG_REPO}/.git" ]]; then
    [[ ! -e "${LOG_REPO}" ]] || die "GO2_LOG_REPO exists but is not a Git checkout: ${LOG_REPO}"
    parent="$(dirname -- "${LOG_REPO}")"
    mkdir -p -- "${parent}"
    git_with_proxy clone "${LOG_REMOTE}" "${LOG_REPO}"
  fi

  [[ -d "${LOG_REPO}/.git" ]] || die "not a Git repository: ${LOG_REPO}"
  assert_log_remote_identity
  ensure_log_repository_identity

  session_path="sessions/${session_id}"
  unrelated="$(git -C "${LOG_REPO}" status --porcelain --untracked-files=all -- . \
    ":(exclude)${session_path}" 2>/dev/null || true)"
  [[ -z "${unrelated}" ]] || die "log repository has unrelated local changes:\n${unrelated}"

  # A failed copy/add/commit is recoverable because the source session remains
  # authoritative. Clear only this session path, never any unrelated work.
  if [[ -n "$(git -C "${LOG_REPO}" status --porcelain --untracked-files=all -- "${session_path}")" ]]; then
    destination="${LOG_REPO}/${session_path}"
    rm -rf -- "${destination}"
    git -C "${LOG_REPO}" reset -q HEAD -- "${session_path}" 2>/dev/null || true
    if git -C "${LOG_REPO}" cat-file -e "HEAD:${session_path}" 2>/dev/null; then
      git -C "${LOG_REPO}" checkout HEAD -- "${session_path}"
    fi
  fi

  git_with_proxy -C "${LOG_REPO}" fetch origin
  if git -C "${LOG_REPO}" show-ref --verify --quiet "refs/heads/${LOG_BRANCH}"; then
    git -C "${LOG_REPO}" checkout "${LOG_BRANCH}"
  elif git -C "${LOG_REPO}" show-ref --verify --quiet "refs/remotes/origin/${LOG_BRANCH}"; then
    git -C "${LOG_REPO}" checkout --track -b "${LOG_BRANCH}" "origin/${LOG_BRANCH}"
  else
    git -C "${LOG_REPO}" checkout -b "${LOG_BRANCH}"
  fi

  if git -C "${LOG_REPO}" show-ref --verify --quiet "refs/remotes/origin/${LOG_BRANCH}"; then
    assert_local_commits_are_diagnostic_only "origin/${LOG_BRANCH}"
    if git -C "${LOG_REPO}" merge-base --is-ancestor HEAD "origin/${LOG_BRANCH}"; then
      git -C "${LOG_REPO}" merge --ff-only "origin/${LOG_BRANCH}"
    elif ! git -C "${LOG_REPO}" merge-base --is-ancestor "origin/${LOG_BRANCH}" HEAD; then
      if ! git -C "${LOG_REPO}" rebase "origin/${LOG_BRANCH}"; then
        git -C "${LOG_REPO}" rebase --abort 2>/dev/null || true
        die "could not replay the pending diagnostic commit onto origin/${LOG_BRANCH}"
      fi
    fi
  fi
}

cleanup_uploaded_sessions() {
  local retention_limit="${1:-${MAX_LOCAL_SESSIONS}}"
  local total candidate resolved_root resolved_candidate
  total="$(find "${SESSIONS_DIR}" -mindepth 1 -maxdepth 1 -type d -printf '.\n' | wc -l)"
  (( total > retention_limit )) || return 0
  resolved_root="$(realpath -- "${SESSIONS_DIR}")"

  while IFS= read -r candidate; do
    (( total > retention_limit )) || break
    [[ -f "${candidate}/.uploaded" && ! -L "${candidate}" ]] || continue
    resolved_candidate="$(realpath -- "${candidate}")"
    [[ "${resolved_candidate}" == "${resolved_root}/"* ]] || continue
    rm -rf -- "${resolved_candidate}"
    total=$((total - 1))
    echo "Removed verified uploaded session: $(basename -- "${candidate}")"
  done < <(find "${SESSIONS_DIR}" -mindepth 1 -maxdepth 1 -type d -printf '%p\n' | LC_ALL=C sort)

  if (( total > retention_limit )); then
    echo "WARNING: ${total} sessions remain because unuploaded sessions are never deleted." >&2
  fi
}

validate_session_id() {
  local session_id="$1"
  [[ ${#session_id} -le 160 ]] || die "session ID is too long"
  [[ "${session_id}" =~ ^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9_.-]+-[1-9][0-9]*$ ]] ||
    die "invalid session ID: ${session_id}"
}

select_session() {
  local requested="${1:-}"
  if [[ -n "${requested}" ]]; then
    validate_session_id "${requested}"
    printf '%s\n' "${SESSIONS_DIR}/${requested}"
    return 0
  fi

  local latest
  latest="$(find "${SESSIONS_DIR}" -mindepth 1 -maxdepth 1 -type d ! -exec test -e '{}/.uploaded' \; \
    -printf '%f\n' 2>/dev/null | LC_ALL=C sort | tail -n 1)"
  [[ -n "${latest}" ]] || die "no unuploaded session found"
  printf '%s\n' "${SESSIONS_DIR}/${latest}"
}

repair_trailing_nul_suffixes() {
  local log_root="$1"
  local session_id="$2"
  local repaired_at="$3"
  local max_file_bytes="$4"

  python3 - \
    "${log_root}" \
    "${session_id}" \
    "${repaired_at}" \
    "${max_file_bytes}" \
    "${REPAIRABLE_SESSION_TEXT_FILES[@]}" <<'PY'
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import stat
import sys

log_root = Path(sys.argv[1])
session_id = sys.argv[2]
repaired_at = sys.argv[3]
max_file_bytes = int(sys.argv[4])
names = sys.argv[5:]
manifest_name = "repair_manifest.jsonl"
no_follow = getattr(os, "O_NOFOLLOW", 0)
directory_flag = getattr(os, "O_DIRECTORY", 0)
effective_uid = os.geteuid()
hash_pattern = re.compile(r"^[0-9a-f]{64}$")
manifest_payload = b""
manifest_records = {}
latest_manifest_key = {}
temporary_counter = 0


def reject(message: str) -> None:
    print(f"go2-log repair rejection: {message}", file=sys.stderr)
    raise SystemExit(1)


def open_owned_directory(path: Path, description: str) -> int:
    try:
        descriptor = os.open(path, os.O_RDONLY | directory_flag | no_follow)
    except OSError as exception:
        reject(f"cannot open {description}: {path}: {exception}")
    metadata = os.fstat(descriptor)
    if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != effective_uid:
        os.close(descriptor)
        reject(f"{description} is not an owned directory: {path}")
    return descriptor


def open_owned_directory_at(parent: int, name: str, description: str) -> int:
    try:
        descriptor = os.open(
            name,
            os.O_RDONLY | directory_flag | no_follow,
            dir_fd=parent,
        )
    except OSError as exception:
        reject(f"cannot open {description}: {name}: {exception}")
    metadata = os.fstat(descriptor)
    if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != effective_uid:
        os.close(descriptor)
        reject(f"{description} is not an owned directory: {name}")
    return descriptor


def ensure_owned_directory_at(parent: int, name: str, description: str) -> int:
    try:
        os.mkdir(name, mode=0o700, dir_fd=parent)
        os.fsync(parent)
    except FileExistsError:
        pass
    return open_owned_directory_at(parent, name, description)


def read_regular(
    directory: int,
    name: str,
    description: str,
    limit: int,
    missing_ok: bool = False,
):
    try:
        descriptor = os.open(name, os.O_RDONLY | no_follow, dir_fd=directory)
    except FileNotFoundError:
        if missing_ok:
            return None
        reject(f"{description} is missing: {name}")
    except OSError as exception:
        reject(f"cannot open {description}: {name}: {exception}")
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode) or before.st_uid != effective_uid:
            reject(f"{description} is not an owned regular file: {name}")
        if before.st_size > limit:
            reject(f"{description} exceeds {limit} bytes: {name}")
        chunks = []
        remaining = before.st_size
        while remaining:
            chunk = os.read(descriptor, min(1024 * 1024, remaining))
            if not chunk:
                reject(f"{description} changed while being read: {name}")
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            reject(f"{description} grew while being read: {name}")
        after = os.fstat(descriptor)
        signature_before = (
            before.st_dev,
            before.st_ino,
            before.st_size,
            before.st_mtime_ns,
            before.st_ctime_ns,
        )
        signature_after = (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_mtime_ns,
            after.st_ctime_ns,
        )
        if signature_before != signature_after:
            reject(f"{description} changed while being read: {name}")
        return b"".join(chunks), before
    finally:
        os.close(descriptor)


def write_all(descriptor: int, payload: bytes) -> None:
    view = memoryview(payload)
    while view:
        written = os.write(descriptor, view)
        if written <= 0:
            raise OSError("short write")
        view = view[written:]


def next_temporary_name(label: str) -> str:
    global temporary_counter
    temporary_counter += 1
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", label)
    nonce = secrets.token_hex(8)
    return f".{safe}.repair-{os.getpid()}-{temporary_counter}-{nonce}.tmp"


def write_quarantine_temporary(quarantine_fd: int, label: str, payload: bytes, mode: int) -> str:
    descriptor = None
    temporary = ""
    for _ in range(100):
        temporary = next_temporary_name(label)
        try:
            descriptor = os.open(
                temporary,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | no_follow,
                mode,
                dir_fd=quarantine_fd,
            )
            break
        except FileExistsError:
            continue
    if descriptor is None:
        reject(f"could not allocate a repair temporary for: {label}")
    try:
        write_all(descriptor, payload)
        os.fsync(descriptor)
    except BaseException:
        os.close(descriptor)
        try:
            os.unlink(temporary, dir_fd=quarantine_fd)
            os.fsync(quarantine_fd)
        except FileNotFoundError:
            pass
        raise
    finally:
        if descriptor is not None:
            try:
                os.close(descriptor)
            except OSError:
                pass
    return temporary


def atomic_replace_from_quarantine(
    quarantine_fd: int,
    target_fd: int,
    target_name: str,
    payload: bytes,
    mode: int,
) -> None:
    temporary = write_quarantine_temporary(
        quarantine_fd, target_name, payload, mode
    )
    try:
        os.replace(
            temporary,
            target_name,
            src_dir_fd=quarantine_fd,
            dst_dir_fd=target_fd,
        )
        os.fsync(quarantine_fd)
        os.fsync(target_fd)
    finally:
        try:
            os.unlink(temporary, dir_fd=quarantine_fd)
        except FileNotFoundError:
            pass


def ensure_quarantined_original(
    quarantine_fd: int,
    name: str,
    payload: bytes,
) -> None:
    existing = read_regular(
        quarantine_fd,
        name,
        "quarantined original",
        max_file_bytes,
        missing_ok=True,
    )
    if existing is not None:
        if existing[0] != payload:
            reject(f"quarantine hash collision: {name}")
        return

    temporary = write_quarantine_temporary(
        quarantine_fd, name, payload, 0o600
    )
    try:
        try:
            os.link(
                temporary,
                name,
                src_dir_fd=quarantine_fd,
                dst_dir_fd=quarantine_fd,
                follow_symlinks=False,
            )
        except FileExistsError:
            existing = read_regular(
                quarantine_fd,
                name,
                "quarantined original",
                max_file_bytes,
            )
            if existing[0] != payload:
                reject(f"quarantine hash collision: {name}")
        os.unlink(temporary, dir_fd=quarantine_fd)
        os.fsync(quarantine_fd)
    finally:
        try:
            os.unlink(temporary, dir_fd=quarantine_fd)
        except FileNotFoundError:
            pass


def analyze_trailing_nul(data: bytes, name: str):
    first_nul = data.find(b"\0")
    if first_nul < 0:
        return None
    if any(memoryview(data)[first_nul:]):
        reject(f"NUL bytes are not a trailing suffix: {name}")
    if first_nul == 0 or data[first_nul - 1] != 0x0A:
        reject(f"text before the trailing NUL suffix is not a complete line: {name}")
    clean = data[:first_nul]
    try:
        clean.decode("utf-8")
    except UnicodeDecodeError:
        reject(f"text before the trailing NUL suffix is not valid UTF-8: {name}")
    return {
        "original_sha256": hashlib.sha256(data).hexdigest(),
        "original_size": len(data),
        "repaired_sha256": hashlib.sha256(clean).hexdigest(),
        "repaired_size": len(clean),
        "trailing_nul_bytes": len(data) - first_nul,
        "clean": clean,
    }


manifest_fields = {
    "file",
    "original_sha256",
    "original_size",
    "quarantine_file",
    "repaired_at",
    "repaired_sha256",
    "repaired_size",
    "trailing_nul_bytes",
}


def validate_record(record, description: str, allow_state: bool):
    expected = manifest_fields | ({"state"} if allow_state else set())
    if not isinstance(record, dict) or set(record) != expected:
        reject(f"invalid {description} schema")
    if record["file"] not in names:
        reject(f"invalid {description} file: {record['file']}")
    for key in ("original_sha256", "repaired_sha256"):
        if not isinstance(record[key], str) or not hash_pattern.fullmatch(record[key]):
            reject(f"invalid {description} {key}")
    for key in (
        "original_size",
        "repaired_size",
        "trailing_nul_bytes",
    ):
        if not isinstance(record[key], int) or isinstance(record[key], bool) or record[key] < 0:
            reject(f"invalid {description} {key}")
    if (
        record["trailing_nul_bytes"] <= 0
        or record["repaired_size"] + record["trailing_nul_bytes"]
        != record["original_size"]
        or record["original_size"] > max_file_bytes
    ):
        reject(f"inconsistent {description} sizes")
    if not isinstance(record["repaired_at"], str) or not record["repaired_at"]:
        reject(f"invalid {description} repaired_at")
    expected_quarantine = (
        f"quarantine/{session_id}/{record['file']}."
        f"{record['original_sha256']}.corrupt"
    )
    if record["quarantine_file"] != expected_quarantine:
        reject(f"invalid {description} quarantine_file")
    if allow_state and record["state"] not in {"prepared", "completed"}:
        reject(f"invalid {description} state")
    return record


def json_line(record) -> bytes:
    return (
        json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n"
    ).encode("utf-8")


root_fd = sessions_fd = session_fd = quarantine_root_fd = quarantine_fd = None
try:
    root_fd = open_owned_directory(log_root, "diagnostics root")
    sessions_fd = open_owned_directory_at(root_fd, "sessions", "sessions root")
    session_fd = open_owned_directory_at(sessions_fd, session_id, "session")
    quarantine_root_fd = ensure_owned_directory_at(
        root_fd, "quarantine", "quarantine root"
    )
    quarantine_fd = ensure_owned_directory_at(
        quarantine_root_fd, session_id, "session quarantine"
    )

    manifest = read_regular(
        session_fd,
        manifest_name,
        "repair manifest",
        1024 * 1024,
        missing_ok=True,
    )
    if manifest is not None:
        manifest_payload = manifest[0]
        if manifest_payload and not manifest_payload.endswith(b"\n"):
            reject("existing repair manifest does not end with a newline")
        try:
            manifest_text = manifest_payload.decode("utf-8")
        except UnicodeDecodeError:
            reject("existing repair manifest is not valid UTF-8")
        for line_number, line in enumerate(manifest_text.splitlines(), 1):
            try:
                record = validate_record(
                    json.loads(line),
                    f"repair manifest record at line {line_number}",
                    False,
                )
            except json.JSONDecodeError:
                reject(f"invalid repair manifest JSON at line {line_number}")
            key = (record["file"], record["original_sha256"])
            if key in manifest_records:
                reject(f"duplicate repair manifest record: {record['file']}")
            manifest_records[key] = record
            latest_manifest_key[record["file"]] = key

    journals = {}
    for entry in sorted(os.listdir(quarantine_fd)):
        if not entry.endswith(".repair.json"):
            continue
        journal_data = read_regular(
            quarantine_fd,
            entry,
            "repair journal",
            1024 * 1024,
        )[0]
        try:
            journal_record = validate_record(
                json.loads(journal_data.decode("utf-8")),
                f"repair journal {entry}",
                True,
            )
        except (UnicodeDecodeError, json.JSONDecodeError):
            reject(f"invalid repair journal JSON: {entry}")
        expected_entry = (
            f"{journal_record['file']}."
            f"{journal_record['original_sha256']}.repair.json"
        )
        if entry != expected_entry:
            reject(f"repair journal filename does not match its record: {entry}")
        key = (journal_record["file"], journal_record["original_sha256"])
        if key in journals:
            reject(f"duplicate repair journal: {entry}")
        journals[key] = journal_record

    plans = {}
    for name in names:
        current = read_regular(
            session_fd,
            name,
            "repairable session file",
            max_file_bytes,
            missing_ok=True,
        )
        if current is None:
            continue
        analysis = analyze_trailing_nul(current[0], name)
        if analysis is None:
            continue
        record = {
            "file": name,
            "original_sha256": analysis["original_sha256"],
            "original_size": analysis["original_size"],
            "quarantine_file": (
                f"quarantine/{session_id}/{name}."
                f"{analysis['original_sha256']}.corrupt"
            ),
            "repaired_at": repaired_at,
            "repaired_sha256": analysis["repaired_sha256"],
            "repaired_size": analysis["repaired_size"],
            "trailing_nul_bytes": analysis["trailing_nul_bytes"],
        }
        plans[(name, analysis["original_sha256"])] = record

    actions = {}
    for key, journal in journals.items():
        name = journal["file"]
        evidence_name = f"{name}.{journal['original_sha256']}.corrupt"
        evidence = read_regular(
            quarantine_fd,
            evidence_name,
            "quarantined original",
            max_file_bytes,
        )[0]
        analysis = analyze_trailing_nul(evidence, evidence_name)
        if analysis is None:
            reject(f"quarantined original has no trailing NUL suffix: {evidence_name}")
        for field in (
            "original_sha256",
            "original_size",
            "repaired_sha256",
            "repaired_size",
            "trailing_nul_bytes",
        ):
            if journal[field] != analysis[field]:
                reject(f"repair journal does not match quarantined original: {evidence_name}")
        manifest_record = {key: value for key, value in journal.items() if key != "state"}
        existing_record = manifest_records.get(key)
        if existing_record is not None and existing_record != manifest_record:
            reject(f"repair manifest conflicts with journal: {name}")
        current = read_regular(
            session_fd,
            name,
            "repairable session file",
            max_file_bytes,
            missing_ok=True,
        )
        if current is None:
            reject(f"repaired session file is missing: {name}")
        current_sha = hashlib.sha256(current[0]).hexdigest()
        if current_sha == journal["original_sha256"] and current[0] == evidence:
            current_state = "original"
        elif current_sha == journal["repaired_sha256"] and current[0] == analysis["clean"]:
            current_state = "repaired"
        else:
            current_state = "other"
        if journal["state"] == "completed":
            if existing_record is None:
                reject(f"completed repair journal has no manifest record: {name}")
            if key != latest_manifest_key.get(name):
                continue
            if current_state == "original":
                actions[key] = manifest_record
            continue
        if current_state == "other":
            reject(f"session file no longer matches its prepared repair journal: {name}")
        actions[key] = manifest_record

    for key, record in plans.items():
        if key in actions:
            continue
        if key in journals:
            continue
        if key in manifest_records:
            reject(f"corrupt file already has a completed manifest record: {record['file']}")
        actions[key] = record

    if not actions:
        print(f"No repairable trailing NUL suffix found in session: {session_id}")
    else:
        for key in sorted(actions):
            record = actions[key]
            name = record["file"]
            evidence_name = f"{name}.{record['original_sha256']}.corrupt"
            journal_name = f"{name}.{record['original_sha256']}.repair.json"

            if key not in journals:
                source = read_regular(
                    session_fd,
                    name,
                    "repairable session file",
                    max_file_bytes,
                )
                current = source[0]
                analysis = analyze_trailing_nul(current, name)
                if (
                    analysis is None
                    or analysis["original_sha256"] != record["original_sha256"]
                    or analysis["repaired_sha256"] != record["repaired_sha256"]
                ):
                    reject(f"session file changed before quarantine: {name}")
                clean = analysis["clean"]
                ensure_quarantined_original(quarantine_fd, evidence_name, current)
                prepared = dict(record, state="prepared")
                atomic_replace_from_quarantine(
                    quarantine_fd,
                    quarantine_fd,
                    journal_name,
                    json_line(prepared),
                    0o600,
                )
            else:
                current = read_regular(
                    quarantine_fd,
                    evidence_name,
                    "quarantined original",
                    max_file_bytes,
                )[0]
                analysis = analyze_trailing_nul(current, evidence_name)
                if analysis is None:
                    reject(f"quarantined original has no trailing NUL suffix: {evidence_name}")
                clean = analysis["clean"]

            latest = read_regular(
                session_fd,
                name,
                "repairable session file",
                max_file_bytes,
            )
            latest_sha = hashlib.sha256(latest[0]).hexdigest()
            if latest_sha == record["original_sha256"] and latest[0] == current:
                atomic_replace_from_quarantine(
                    quarantine_fd,
                    session_fd,
                    name,
                    clean,
                    stat.S_IMODE(latest[1].st_mode),
                )
            elif latest_sha != record["repaired_sha256"] or latest[0] != clean:
                reject(f"session file changed during repair: {name}")

            if key not in manifest_records:
                manifest_payload += json_line(record)
                atomic_replace_from_quarantine(
                    quarantine_fd,
                    session_fd,
                    manifest_name,
                    manifest_payload,
                    0o600,
                )
                manifest_records[key] = record
                latest_manifest_key[name] = key

            completed = dict(record, state="completed")
            atomic_replace_from_quarantine(
                quarantine_fd,
                quarantine_fd,
                journal_name,
                json_line(completed),
                0o600,
            )
            print(
                f"Repaired trailing NUL suffix: {name} "
                f"({record['trailing_nul_bytes']} bytes)"
            )
            print(
                "Preserved original: "
                f"{log_root / record['quarantine_file']}"
            )

        print(f"Repair manifest: {log_root / 'sessions' / session_id / manifest_name}")
finally:
    for descriptor in (
        quarantine_fd,
        quarantine_root_fd,
        session_fd,
        sessions_fd,
        root_fd,
    ):
        if descriptor is not None:
            os.close(descriptor)
PY
}

repair_session() {
  acquire_lock
  command -v python3 >/dev/null 2>&1 || die "python3 is required"
  local session_dir session_id active collector_pid writers size
  session_dir="$(select_session "${1:-}")"
  session_id="$(basename -- "${session_dir}")"
  validate_session_id "${session_id}"

  [[ -d "${session_dir}" && ! -L "${session_dir}" ]] ||
    die "invalid or symbolic-link session directory: ${session_dir}"
  [[ ! -e "${session_dir}/.uploaded" && ! -L "${session_dir}/.uploaded" ]] ||
    die "refusing to modify an already uploaded session: ${session_id}"
  size="$(session_bytes "${session_dir}")"
  (( size <= SESSION_MAX_BYTES )) ||
    die "session exceeds 100 MiB; preserve it with SCP instead of repairing in place"
  if active="$(active_session_dir 2>/dev/null)"; then
    die "collection is active ($(basename -- "${active}")); stop it before repair"
  fi
  collector_pid="$(read_first_line "${session_dir}/collector.pid" 2>/dev/null || true)"
  if collector_is_running "${collector_pid}" "${session_dir}"; then
    die "selected session is still being collected by PID ${collector_pid}"
  fi
  if ! writers="$(running_diagnostic_writers)"; then
    die "diagnostic writer process query failed before repair"
  fi
  if [[ -n "${writers}" ]]; then
    echo "${writers}" >&2
    die "stop all diagnostic writers before repair"
  fi
  assert_robot_idle "diagnostic repair" ||
    die "stop all robot processes before repairing diagnostics"

  repair_trailing_nul_suffixes \
    "${LOG_ROOT}" "${session_id}" "$(utc_now)" "${MAX_GIT_FILE_BYTES}"
  validate_repair_evidence "${session_dir}"
  validate_session_for_upload "${session_dir}" true
  echo "Session text validation passed after repair: ${session_id}"
}

validate_staged_session() {
  local session_id="$1"
  local session_path="sessions/${session_id}"
  local destination="${LOG_REPO}/${session_path}"
  local unrelated path staged_hash worktree_hash

  unrelated="$(git -C "${LOG_REPO}" status --porcelain --untracked-files=all -- . \
    ":(exclude)${session_path}" 2>/dev/null || true)"
  [[ -z "${unrelated}" ]] || die "unrelated log-repository changes detected:\n${unrelated}"
  validate_session_for_upload "${destination}"

  while IFS= read -r -d '' path; do
    [[ "${path}" == "${session_path}"/* ]] ||
      die "staged change escaped the selected session: ${path}"
  done < <(git -C "${LOG_REPO}" diff --cached --name-only -z)

  while IFS= read -r -d '' path; do
    [[ -f "${LOG_REPO}/${path}" && ! -L "${LOG_REPO}/${path}" ]] ||
      die "staged file is not a regular worktree file: ${path}"
    staged_hash="$(git -C "${LOG_REPO}" rev-parse --verify ":${path}")"
    worktree_hash="$(git -C "${LOG_REPO}" hash-object -- "${LOG_REPO}/${path}")"
    [[ "${staged_hash}" == "${worktree_hash}" ]] ||
      die "file changed after validation and staging: ${path}"
  done < <(git -C "${LOG_REPO}" diff --cached --name-only --diff-filter=ACMRT -z -- "${session_path}")
}

upload_session() {
  acquire_lock
  command -v python3 >/dev/null 2>&1 || die "python3 is required"
  local session_dir session_id active destination local_sha remote_sha collector_pid writers
  session_dir="$(select_session "${1:-}")"
  session_id="$(basename -- "${session_dir}")"
  validate_session_id "${session_id}"

  if [[ -f "${session_dir}/.uploaded" ]]; then
    echo "Session is already verified as uploaded: ${session_id}"
    cleanup_uploaded_sessions
    return 0
  fi

  if active="$(active_session_dir 2>/dev/null)"; then
    die "collection is active ($(basename -- "${active}")); stop it before upload"
  fi
  collector_pid="$(read_first_line "${session_dir}/collector.pid" 2>/dev/null || true)"
  if collector_is_running "${collector_pid}" "${session_dir}"; then
    die "selected session is still being collected by PID ${collector_pid}"
  fi
  if ! writers="$(running_diagnostic_writers)"; then
    die "diagnostic writer process query failed before upload"
  fi
  if [[ -n "${writers}" ]]; then
    echo "${writers}" >&2
    die "stop all diagnostic writers before upload"
  fi
  assert_robot_idle "diagnostic upload" ||
    die "stop all robot processes before uploading diagnostics"

  # Reject artifacts and binary data before any optional text compaction can
  # alter a stopped session. The strict size checks run after compaction.
  validate_repair_evidence "${session_dir}"
  validate_session_for_upload "${session_dir}" true
  enforce_session_size_limit "${session_dir}" ||
    die "session remains oversized; preserve it with SCP before removing it"
  validate_repair_evidence "${session_dir}"
  validate_session_for_upload "${session_dir}"

  prepare_log_repository "${session_id}"
  destination="${LOG_REPO}/sessions/${session_id}"
  rm -rf -- "${destination}"
  mkdir -p -- "${destination}"
  cp -a -- "${session_dir}/." "${destination}/"
  rm -f -- "${destination}/.uploaded"
  validate_session_for_upload "${destination}"

  git -C "${LOG_REPO}" add -A -- "sessions/${session_id}"
  validate_staged_session "${session_id}"
  if ! git -C "${LOG_REPO}" diff --cached --quiet -- "sessions/${session_id}"; then
    git -C "${LOG_REPO}" commit -m "Add diagnostic session ${session_id}" -- "sessions/${session_id}"
  fi

  # The clone/copy/commit phase can take long enough for a robot process to
  # start after the first check. Re-check immediately before network push.
  assert_robot_idle "Git push" ||
    die "robot process started during upload; the local commit is retained for retry"
  git_with_proxy -C "${LOG_REPO}" push origin "HEAD:refs/heads/${LOG_BRANCH}"
  local_sha="$(git -C "${LOG_REPO}" rev-parse HEAD)"
  remote_sha="$(git_with_proxy -C "${LOG_REPO}" ls-remote origin "refs/heads/${LOG_BRANCH}" | awk '{print $1}')"
  [[ -n "${remote_sha}" && "${remote_sha}" == "${local_sha}" ]] ||
    die "push could not be verified; local logs were preserved"

  {
    echo "uploaded_at=$(utc_now)"
    echo "repository_identity=${LOG_REMOTE_IDENTITY}"
    echo "branch=${LOG_BRANCH}"
    echo "commit=${local_sha}"
  } > "${session_dir}/.uploaded"

  echo "Uploaded and verified session: ${session_id}"
  echo "Commit: ${local_sha}"
  cleanup_uploaded_sessions
}

show_usage() {
  cat <<'EOF'
Usage: go2-log <command> [arguments]

Commands:
  start [--result-file PATH]
                        Start a bounded diagnostic session. The optional file
                        receives the lock-consistent machine-readable result.
  status                Show collector state and session size.
  planner-check [ARGS]  Inspect planner inputs and record them in the session.
  planner-series [--samples N] [--interval SEC] [INSPECTOR ARGS]
                        Repeat planner checks (defaults: N=10, SEC=1.0).
                        Pass --no-goal (recommended) or --goal-x/--goal-y.
  stop [SESSION_ID]     Stop the active diagnostic session cleanly; optionally
                        require its ID to match before stopping it.
  repair [SESSION_ID]   Quarantine and trim a verified trailing-NUL text suffix.
  upload [SESSION_ID]   Push a stopped session to Aphra-neck/G02_log.

Environment:
  GO2_LOG_ROOT          Runtime root (default: ~/go2_logs)
  GO2_WORKSPACE         GO2_Hesai workspace (default: current Git checkout)
  GO2_LOG_REPO          Local G02_log checkout (default: ~/G02_log)
  GO2_LOG_PROXY         Git HTTP(S) proxy (default: http://192.168.151.132:7890)
  GO2_LOG_REMOTE        Git remote URL
  GO2_LOG_BRANCH        Git branch (default: main)
EOF
}

main() {
  local command="${1:-}"
  case "${command}" in
    start)
      if [[ $# -eq 1 ]]; then
        start_session
      elif [[ $# -eq 3 && "${2}" == --result-file && -n "${3}" ]]; then
        start_session "${3}"
      else
        die "start accepts only an optional --result-file PATH"
      fi
      ;;
    status)
      [[ $# -eq 1 ]] || die "status takes no arguments"
      status_session
      ;;
    planner-check)
      shift
      planner_check "$@"
      ;;
    planner-series)
      shift
      planner_series "$@"
      ;;
    stop)
      [[ $# -le 2 ]] || die "stop accepts at most one session ID"
      stop_session "${2:-}"
      ;;
    repair)
      [[ $# -le 2 ]] || die "repair accepts at most one session ID"
      repair_session "${2:-}"
      ;;
    upload)
      [[ $# -le 2 ]] || die "upload accepts at most one session ID"
      upload_session "${2:-}"
      ;;
    _collect)
      [[ $# -eq 2 ]] || exit 2
      run_collector "$2"
      ;;
    _rosout)
      [[ $# -eq 2 ]] || exit 2
      run_rosout_collector "$2"
      ;;
    _timing)
      [[ $# -eq 2 ]] || exit 2
      run_topic_timing_sampler "$2"
      ;;
    -h|--help|help)
      show_usage
      ;;
    *)
      show_usage >&2
      exit 2
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
